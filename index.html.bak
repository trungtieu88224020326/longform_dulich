ight);margin:0;padding:0 calc(var(--_padding) - var(--vds-interactive-border-width));border:var(--vds-interactive-border-width) solid transparent;border-radius:var(--vds-radii-xl);background-color:var(--vds-surface-input-rest);color:var(--vds-text-subdued);font:var(--vds-font-microcopy-label-bold-lg);white-space:nowrap;cursor:pointer;user-select:none;appearance:none}.vds-selection-item-chip>svg,.vds-selection-item-chip__icon{display:inline-flex;flex:none;width:24px;height:24px;color:var(--_icon)}.vds-selection-item-chip__icon>svg{width:100%;height:100%}.vds-selection-item-chip--sm{--_height:var(--vds-component-button-height-sm);--_padding:var(--vds-spacing-xs);gap:var(--vds-spacing-3xs);font:var(--vds-font-microcopy-label-bold-md)}.vds-selection-item-chip--lg{--_height:var(--vds-component-button-height-xl)}.vds-selection-item-chip--selected{--_icon:var(--vds-icon-fill-accent-regular);border-color:var(--vds-border-accent-subdued);background-color:var(--vds-surface-input-accent-selected);color:var(--vds-text-accent-regular)}.vds-selection-item-chip:disabled,.vds-selection-item-chip[aria-disabled='true']{opacity:0.3;cursor:default}.vds-tabs{display:flex;gap:var(--vds-spacing-4xs);max-width:100%;overflow-x:auto;scrollbar-width:none}.vds-tabs::-webkit-scrollbar{display:none}.vds-tabs--fixed>.vds-tabs__item{flex:1 1 0;min-width:0}.vds-tabs__item{position:relative;display:inline-flex;align-items:center;justify-content:center;flex:none;box-sizing:border-box;height:var(--vds-component-button-height-md);margin:0;padding:0 var(--vds-spacing-sm);border:0;border-radius:var(--vds-radii-md);background:transparent;color:var(--vds-text-subdued);font:var(--vds-font-microcopy-label-regular-md);white-space:nowrap;cursor:pointer;user-select:none;appearance:none;-webkit-tap-highlight-color:transparent}.vds-tabs__item::after{content:'';position:absolute;inset:auto 0 0;height:var(--vds-border-weight-lg);background:var(--vds-border-subdued);opacity:0.5;pointer-events:none}.vds-tabs__item:active{color:var(--vds-text-regular-lighter)}.vds-tabs__item[aria-selected='true']{color:var(--vds-text-accent-regular);font:var(--vds-font-microcopy-label-bold-md)}.vds-tabs__item[aria-selected='true']::after{background:var(--vds-icon-fill-accent-strong)}.vds-tabs__label{display:inline-grid;justify-items:center}.vds-tabs__label>span,.vds-tabs__label::after{grid-area:1 / 1}.vds-tabs__label::after{content:attr(data-text);height:0;overflow:hidden;visibility:hidden;font:var(--vds-font-microcopy-label-bold-md)}.vds-tabs__item:focus-visible{outline:none;box-shadow:0 0 0 var(--vds-component-focus-border-weight) var(--vds-border-focus)}.vds-tabs__item:disabled{opacity:0.3;cursor:default}@media (forced-colors:active){.vds-tabs__item:focus-visible{outline:var(--vds-component-focus-border-weight) solid CanvasText}}.vds-user-avatar{--vds-user-avatar-size:24px;--vds-user-avatar-badge:9px;--vds-user-avatar-badge-out:1px;--vds-user-avatar-gap:2px;position:relative;display:inline-block;flex:none;width:var(--vds-user-avatar-size);height:var(--vds-user-avatar-size);vertical-align:middle}.vds-user-avatar--20{--vds-user-avatar-size:20px;--vds-user-avatar-badge:7.5px;--vds-user-avatar-badge-out:0.833px;--vds-user-avatar-gap:1.667px}.vds-user-avatar--32{--vds-user-avatar-size:32px;--vds-user-avatar-badge:12px;--vds-user-avatar-badge-out:1px;--vds-user-avatar-gap:2.667px}.vds-user-avatar__face{box-sizing:border-box;display:flex;align-items:center;justify-content:center;width:100%;height:100%;margin:0;overflow:hidden;border-radius:50%;background:var(--vds-component-avatar-surface-enabled);color:var(--vds-component-avatar-text);font-family:var(--vds-microcopy-font-family);font-weight:var(--vds-microcopy-label-font-weight-regular);font-size:calc(var(--vds-user-avatar-size) * 0.5333);line-height:1;text-transform:uppercase;object-fit:cover}.vds-user-avatar--unread .vds-user-avatar__face{--vds-user-avatar-hole:calc(var(--vds-user-avatar-badge) / 2 + var(--vds-user-avatar-gap));--vds-user-avatar-mask:radial-gradient( circle at calc(100% + var(--vds-user-avatar-badge-out) - var(--vds-user-avatar-badge) / 2) calc(var(--vds-user-avatar-badge) / 2 - var(--vds-user-avatar-badge-out)),transparent var(--vds-user-avatar-hole),#000 calc(var(--vds-user-avatar-hole) + 0.5px) );-webkit-mask-image:var(--vds-user-avatar-mask);mask-image:var(--vds-user-avatar-mask)}.vds-user-avatar--unread::after{content:'';position:absolute;top:calc(var(--vds-user-avatar-badge-out) * -1);right:calc(var(--vds-user-avatar-badge-out) * -1);width:var(--vds-user-avatar-badge);height:var(--vds-user-avatar-badge);border-radius:50%;background:var(--vds-component-badge-fill)}
</style>
<style id="article-css">
/* Bài longform dựng trên VDS 0.5.0: mọi màu, cỡ chữ, khoảng cách, bo góc lấy từ token --vds-*.
   Ngoại lệ có chủ đích (VDS chưa có token cỡ hiển thị lớn cho longform): tiêu đề bài, tiêu đề chương và số liệu nổi bật
   được nhân từ token gốc bằng calc(); khung chữ đọc 680px và container 1130px theo trang Layout. */
:root{
  --measure:680px; --container:1130px;
  --c-vn:var(--vds-text-accent-strong);
  --c-other:var(--vds-border-support-regular);
  --c-other-soft:var(--vds-surface-support);
  --c-base:var(--vds-surface-300);
  --c-track:var(--vds-surface-200);
  --rule:var(--vds-component-divider-thickness-regular) solid var(--vds-component-divider-fill-subdued);
  --rule-strong:var(--vds-component-divider-thickness-regular) solid var(--vds-component-divider-fill-regular);
  --rule-black:var(--vds-component-divider-thickness-regular) solid var(--vds-component-divider-fill-strong);
  --display-title:var(--vds-article-title-primary-font-size-xl);
  --display-num:calc(var(--vds-numeric-font-size-2xl) * 1.6);
  --header-h:48px;
  --vh:100vh;
}
@supports (height:100svh){:root{--vh:100svh}}
@media (min-width:1024px){:root{--display-title:calc(var(--vds-article-title-primary-font-size-xl) * 1.75);--display-num:calc(var(--vds-numeric-font-size-2xl) * 2);--header-h:64px}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--vds-surface-paper-000);color:var(--vds-text-article-paragraph);font:var(--vds-font-article-paragraph-standard-regular-lg);overflow-x:hidden;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
button{font:inherit;color:inherit}
a{color:var(--vds-text-link-regular);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:2px}
strong,b{font-weight:700}
:focus-visible{outline:var(--vds-component-divider-thickness-medium) solid var(--vds-border-focus);outline-offset:var(--vds-spacing-4xs)}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.vds-icon-inline svg{display:block}

/* ---------- khung ---------- */
.prose{max-width:calc(var(--measure) + 2 * var(--vds-spacing-margin-md));margin:0 auto;padding:0 var(--vds-spacing-margin-md);position:relative}
.wide{max-width:calc(var(--container) + 2 * var(--vds-spacing-margin-md));margin:0 auto;padding:0 var(--vds-spacing-margin-md)}
.mid{max-width:calc(900px + 2 * var(--vds-spacing-margin-md));margin:0 auto;padding:0 var(--vds-spacing-margin-md)}
.prose p{margin:0 0 var(--vds-spacing-md)}
.sp-lg{height:var(--vds-spacing-2xl)}.sp-xl{height:var(--vds-spacing-4xl)}
@media (max-width:359px){.prose,.wide,.mid{padding:0 var(--vds-spacing-margin-sm)}}
.meta{font:var(--vds-font-microcopy-label-regular-xsm);color:var(--vds-text-subdued-lighter)}
.lbl{font:var(--vds-font-microcopy-label-bold-sm);color:var(--vds-text-regular-lighter)}
.src{font:var(--vds-font-microcopy-label-regular-xsm);color:var(--vds-text-subdued);border-top:var(--rule);padding-top:var(--vds-spacing-2xs);margin-top:var(--vds-spacing-sm)}
.num{font-family:var(--vds-numeric-font-family);font-variant-numeric:tabular-nums}

/* ---------- header ---------- */
#bar{position:sticky;top:0;z-index:50;height:var(--header-h);background:var(--vds-surface-000);border-bottom:var(--rule-strong)}
#bar .in{max-width:calc(var(--container) + 2 * var(--vds-spacing-margin-md));height:100%;margin:0 auto;padding:0 var(--vds-spacing-xs) 0 var(--vds-spacing-margin-md);display:flex;align-items:center;gap:var(--vds-spacing-xs)}
#bar .logo svg{height:24px;width:auto;display:block}
#bar .cat{font:var(--vds-font-microcopy-label-bold-md);color:var(--vds-component-news-travel-fill);text-decoration:none;white-space:nowrap}
#bar .ch{flex:1;min-width:0;font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-subdued);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#bar .vds-divider-vertical{height:var(--vds-spacing-sm)}
#prog{position:absolute;left:0;bottom:calc(-1 * var(--vds-component-divider-thickness-medium));height:var(--vds-component-divider-thickness-medium);width:100%;background:var(--vds-text-accent-strong);transform-origin:left;transform:scaleX(0)}
#menuBtn{margin-left:auto}
@media (max-width:520px){#bar .ch{display:none}}

#menu{position:fixed;inset:0;z-index:60;visibility:hidden;overflow:hidden}
#menu.open{visibility:visible}
#menu .scrim{position:absolute;inset:0;background:var(--vds-icon-background-contrast);opacity:0;transition:opacity .3s}
#menu.open .scrim{opacity:.5}
#menu nav{position:absolute;right:0;top:0;bottom:0;width:min(400px,92vw);background:var(--vds-surface-000);box-shadow:var(--vds-shadow-elavation-B);transform:translateX(100%);transition:transform .4s cubic-bezier(.2,.8,.2,1);display:flex;flex-direction:column}
#menu.open nav{transform:none}
#menu .mh{height:var(--header-h);display:flex;align-items:center;justify-content:space-between;padding:0 var(--vds-spacing-xs) 0 var(--vds-spacing-margin-md);border-bottom:var(--rule-strong)}
#menu .mh span{font:var(--vds-font-heading-sm);color:var(--vds-text-regular)}
#menu ol{list-style:none;margin:0;padding:0 var(--vds-spacing-margin-md);overflow:auto}
#menu li a{display:grid;grid-template-columns:var(--vds-spacing-xl) 1fr;padding:var(--vds-spacing-sm) 0;border-bottom:var(--rule);text-decoration:none;color:var(--vds-text-article-title);font:var(--vds-font-article-title-primary-bold-sm)}
#menu li a span{font:var(--vds-font-numeric-regular-md);color:var(--vds-text-accent-strong);padding-top:var(--vds-spacing-4xs)}
#menu .mf{margin-top:auto;padding:var(--vds-spacing-sm) var(--vds-spacing-margin-md);border-top:var(--rule)}

/* ---------- mở đầu ---------- */
.masthead{padding:var(--vds-spacing-xl) 0 var(--vds-spacing-lg)}
.kicker{display:flex;gap:var(--vds-spacing-2xs);align-items:center;font:var(--vds-font-microcopy-label-bold-md);color:var(--vds-component-news-travel-fill);margin-bottom:var(--vds-spacing-sm)}
.kicker .vds-divider-vertical{height:var(--vds-spacing-sm)}
.kicker span:last-child{color:var(--vds-text-subdued);font:var(--vds-font-microcopy-label-regular-md)}
h1.title{font:var(--vds-font-article-title-primary-black-xl);font-size:var(--display-title);line-height:1.22;color:var(--vds-text-article-title);margin:0 0 var(--vds-spacing-md);max-width:15em;letter-spacing:-.01em}
.lead{font:var(--vds-font-article-paragraph-standard-regular-lg);color:var(--vds-text-article-lead);margin:0 0 var(--vds-spacing-md);max-width:var(--measure)}
.byline{display:flex;flex-wrap:wrap;gap:var(--vds-spacing-3xs) var(--vds-spacing-md);font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-subdued);border-top:var(--rule);padding-top:var(--vds-spacing-xs)}
.byline b{color:var(--vds-text-regular);font-weight:700}
@media (min-width:1024px){.masthead .wide{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:0 var(--vds-spacing-2xl);align-items:end}.masthead .side{border-left:var(--rule);padding-left:var(--vds-spacing-md)}}

/* bản đồ thế giới: lớp media nền tối (surface/dark/000) */
.heromap{position:relative;background:var(--vds-surface-dark-000);height:min(72vh,760px);min-height:420px;overflow:hidden}
@media (max-width:760px){.heromap{height:62vh;min-height:380px}}
#heroCanvas{position:absolute;inset:0;width:100%;height:100%}
.heromap .legend{position:absolute;left:var(--vds-spacing-margin-md);bottom:var(--vds-spacing-sm);right:var(--vds-spacing-margin-md);display:flex;flex-wrap:wrap;gap:var(--vds-spacing-3xs) var(--vds-spacing-md);font:var(--vds-font-microcopy-label-regular-xsm);color:var(--vds-text-on-color-regular-lighter)}
.heromap .legend span{display:flex;align-items:center;gap:var(--vds-spacing-3xs)}
.heromap .legend i.ln{width:var(--vds-spacing-sm);height:var(--vds-component-divider-thickness-regular);border-radius:0;background:var(--vds-icon-fill-accent-regular)}
.heromap .legend i{width:var(--vds-spacing-2xs);height:var(--vds-spacing-2xs);border-radius:var(--vds-radii-circle);display:inline-block}
.caption{font:var(--vds-font-article-paragraph-standard-regular-md);color:var(--vds-text-article-caption);padding-top:var(--vds-spacing-2xs)}

/* ---------- đọc nhanh ---------- */
.quick{border-top:var(--rule-black);border-bottom:var(--rule-strong);padding:var(--vds-spacing-sm) 0 var(--vds-spacing-2xs);margin:var(--vds-spacing-2xl) 0 0}
.quick h2{font:var(--vds-font-heading-sm);color:var(--vds-text-accent-strong);margin:0 0 var(--vds-spacing-2xs)}
.quick ul{list-style:none;margin:0;padding:0}
.quick li{display:grid;grid-template-columns:88px 1fr;gap:var(--vds-spacing-sm);padding:var(--vds-spacing-xs) 0;border-top:var(--rule);font:var(--vds-font-article-summary-standard-regular-md);color:var(--vds-text-article-paragraph)}
.quick li:first-child{border-top:0}
.quick li .n{font:var(--vds-font-numeric-bold-xl);color:var(--vds-text-regular);line-height:1.1}
.quick li .n small{display:block;font:var(--vds-font-microcopy-label-regular-xs);color:var(--vds-text-subdued)}

/* ---------- mở chương ---------- */
.chapter{margin:var(--vds-spacing-4xl) 0 var(--vds-spacing-xl)}
.chapter .vds-divider-horizontal{margin:0}
.chapter .in{display:grid;grid-template-columns:1fr;gap:var(--vds-spacing-2xs);padding-top:var(--vds-spacing-md)}
.chapter .no{font:var(--vds-font-numeric-bold-md);color:var(--vds-text-accent-strong)}
.chapter h2{font:var(--vds-font-article-title-primary-black-xl);line-height:1.25;color:var(--vds-text-article-title);margin:0;max-width:18em}
.chapter p{font:var(--vds-font-article-paragraph-standard-regular-lg);color:var(--vds-text-article-lead);margin:var(--vds-spacing-2xs) 0 0;max-width:var(--measure)}
@media (min-width:1024px){.chapter .in{grid-template-columns:160px minmax(0,1fr);gap:0 var(--vds-spacing-lg)}.chapter .no{font:var(--vds-font-numeric-regular-2xl);font-size:var(--display-num);line-height:1}.chapter h2{font-size:calc(var(--vds-article-title-primary-font-size-xl) * 1.25)}}

/* ---------- reveal (tiết chế) ---------- */
.rv{opacity:0;transform:translateY(var(--vds-spacing-xs));transition:opacity .7s ease,transform .7s ease}
.rv.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}}

/* ---------- ghi chú lề, trích dẫn ---------- */
.note{border-top:var(--rule-black);border-bottom:var(--rule);padding:var(--vds-spacing-xs) 0;margin:var(--vds-spacing-md) 0;font:var(--vds-font-article-paragraph-standard-regular-md);color:var(--vds-text-article-paragraph)}
.note .lbl{display:block;color:var(--vds-text-accent-strong);margin-bottom:var(--vds-spacing-3xs)}
@media (min-width:1240px){.note{float:left;clear:left;width:220px;margin:var(--vds-spacing-3xs) 0 var(--vds-spacing-md) calc(-220px - var(--vds-spacing-2xl));font:var(--vds-font-article-paragraph-standard-regular-sm)}}
.quote{margin:var(--vds-spacing-xl) 0;padding:var(--vds-spacing-md) 0 0;border-top:var(--rule-black)}
.quote blockquote{margin:0;font:var(--vds-font-article-title-primary-regular-mlg);line-height:1.5;color:var(--vds-text-article-title)}
.quote cite{display:block;margin-top:var(--vds-spacing-xs);font-style:normal;font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-subdued)}
.quote cite b{color:var(--vds-text-regular);font-weight:700}
@media (min-width:1024px){.quote.out{margin-left:calc(-1 * var(--vds-spacing-4xl));margin-right:calc(-1 * var(--vds-spacing-4xl))}.quote.out blockquote{font:var(--vds-font-article-title-primary-regular-lg);font-size:var(--vds-article-title-primary-font-size-xl);line-height:1.45}}

/* ---------- khối đồ họa ---------- */
.gfx{border-top:var(--rule-black);padding-top:var(--vds-spacing-sm);margin:var(--vds-spacing-xl) 0}
.gfx-h{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:var(--vds-spacing-xs) var(--vds-spacing-md);margin-bottom:var(--vds-spacing-md)}
.gfx-h h3{font:var(--vds-font-heading-md);color:var(--vds-text-regular);margin:0;max-width:34em}
.gfx-h .sub{font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-subdued);margin:var(--vds-spacing-3xs) 0 0}
.chips{display:flex;flex-wrap:wrap;gap:var(--vds-spacing-2xs)}
.chips.scroll{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;margin:0 calc(-1 * var(--vds-spacing-margin-md));padding:0 var(--vds-spacing-margin-md) var(--vds-spacing-4xs)}
.chips.scroll::-webkit-scrollbar{display:none}
.chips.scroll .vds-selection-item-chip{flex:none}

/* ---------- scrollytelling ---------- */
.scrolly{position:relative;margin:var(--vds-spacing-xl) 0}
.scrolly .stk{position:sticky;top:var(--header-h);height:calc(var(--vh) - var(--header-h));overflow:hidden;border-top:var(--rule-strong);border-bottom:var(--rule-strong)}
.scrolly .g{position:absolute;inset:0 0 36% 0}
.scrolly .steps{position:relative;z-index:2;margin-top:calc(-1 * (var(--vh) - var(--header-h)));pointer-events:none}
.step{min-height:var(--vh);display:flex;align-items:center;justify-content:center;padding:0 var(--vds-spacing-margin-md)}
.step:last-child{min-height:calc(var(--vh) + 20vh)}
.step .card{pointer-events:auto;width:100%;max-width:400px;background:var(--vds-surface-000);border:var(--rule-strong);border-radius:var(--vds-radii-md);padding:var(--vds-spacing-sm);font:var(--vds-font-article-paragraph-standard-regular-md);color:var(--vds-text-article-paragraph);opacity:.55;transition:opacity .4s}
.step.active .card{opacity:1}
.step .card p{margin:0 0 var(--vds-spacing-2xs)}.step .card p:last-child{margin:0}
.step .card .t{display:block;font:var(--vds-font-microcopy-label-bold-sm);color:var(--vds-text-accent-strong);margin-bottom:var(--vds-spacing-3xs)}
@media (min-width:1024px){
  .scrolly .g{inset:0 0 0 38%}
  .step{justify-content:flex-start;padding-left:max(var(--vds-spacing-margin-md),calc(50% - var(--container) / 2))}
  .step .card{max-width:380px;font:var(--vds-font-article-paragraph-standard-regular-lg)}
}

/* ---------- bản đồ khu vực (SVG) ---------- */
.mapsvg{width:100%;height:100%;display:block}
.mapsvg .nb{fill:var(--vds-surface-200);stroke:var(--vds-border-subdued);stroke-width:.6;vector-effect:non-scaling-stroke}
.mapsvg .vn{fill:var(--c-other-soft);stroke:var(--c-other);stroke-width:1;vector-effect:non-scaling-stroke}
.mapsvg .kh.hl{fill:var(--vds-surface-300)}
.mapsvg .isl{fill:var(--c-other)}
.mapsvg .ns{transform:scale(var(--k,1))}
.mapsvg text{font-family:var(--vds-microcopy-font-family);fill:var(--vds-text-regular-lighter);font-size:var(--vds-microcopy-label-font-size-sm)}
.mapsvg .cty{font-weight:700;font-size:var(--vds-microcopy-label-font-size-xs);fill:var(--vds-text-subdued);letter-spacing:.08em;text-transform:uppercase}
.mapsvg .isl-t{font-size:var(--vds-microcopy-label-font-size-xs);fill:var(--vds-text-subdued)}
.mapsvg .city{fill:var(--vds-text-regular)}
.mapsvg .city.hcm{fill:var(--c-vn)}
.mapsvg .lb{font-weight:700;fill:var(--vds-text-regular);font-size:var(--vds-microcopy-label-font-size-md);paint-order:stroke;stroke:var(--vds-surface-paper-000);stroke-width:3px}
.mapsvg .yr{font-family:var(--vds-numeric-font-family);font-weight:700;fill:var(--c-vn);font-size:var(--vds-numeric-font-size-md);paint-order:stroke;stroke:var(--vds-surface-paper-000);stroke-width:3px}
.mapsvg .yr.b{fill:var(--vds-text-regular)}
.mapsvg .fl-t{font-weight:700;fill:var(--c-vn);font-size:var(--vds-microcopy-label-font-size-sm)}
.mapsvg .route{fill:none;stroke:var(--c-vn);stroke-width:calc(2.5px * var(--k,1));stroke-linecap:round}
.mapsvg .flow{fill:none;stroke:var(--c-vn);stroke-opacity:.45;stroke-width:1.2;stroke-dasharray:3 4;vector-effect:non-scaling-stroke}
.mapsvg .part{fill:var(--c-vn)}
.mapsvg .fade{opacity:0;transition:opacity .5s}
.mapsvg .fade.on{opacity:1}
.pill{position:absolute;left:50%;top:var(--vds-spacing-sm);transform:translateX(-50%);background:var(--vds-surface-000);border:var(--rule-strong);border-radius:var(--vds-radii-md);padding:var(--vds-spacing-3xs) var(--vds-spacing-xs);font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-regular-lighter);white-space:nowrap;opacity:0;transition:opacity .4s}
.pill b{font:var(--vds-font-numeric-bold-lg);color:var(--c-vn);margin-right:var(--vds-spacing-3xs)}
.pill.on{opacity:1}

/* ---------- đề án 2030 ---------- */
.plan-m{display:grid;gap:var(--vds-spacing-md)}
@media (min-width:760px){.plan-m{grid-template-columns:1fr 1fr;gap:0}.plan-m .pm+.pm{border-left:var(--rule);padding-left:var(--vds-spacing-md)}.plan-m .pm{padding-right:var(--vds-spacing-md)}}
.pm .k{font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-subdued)}
.pm .v{font:var(--vds-font-numeric-bold-2xl);font-size:var(--display-num);color:var(--vds-text-regular);line-height:1.15;margin:var(--vds-spacing-3xs) 0 var(--vds-spacing-xs)}
.pm .v small{font:var(--vds-font-microcopy-label-regular-md);color:var(--vds-text-subdued);margin-left:var(--vds-spacing-3xs)}
.pm .track{height:var(--vds-spacing-xs);background:var(--c-track);position:relative}
.pm .fill{position:absolute;inset:0 auto 0 0;background:var(--c-other);transition:width 1s ease}
.pm.y30 .fill{background:var(--c-vn)}
.pm .ghost{position:absolute;top:calc(-1 * var(--vds-spacing-3xs));bottom:calc(-1 * var(--vds-spacing-3xs));border-left:var(--vds-component-divider-thickness-medium) solid var(--vds-surface-000);opacity:0;transition:opacity .3s .6s}
.pm.y30 .ghost{opacity:1}
.pm .x{display:block;margin-top:var(--vds-spacing-2xs);font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-subdued);min-height:1.5em}
.kpis{display:grid;grid-template-columns:1fr 1fr;margin-top:var(--vds-spacing-lg);border-top:var(--rule)}
.kpi{padding:var(--vds-spacing-sm) var(--vds-spacing-sm) var(--vds-spacing-sm) 0;border-bottom:var(--rule)}
.kpi:nth-child(odd){border-right:var(--rule)}
.kpi:nth-child(even){padding-left:var(--vds-spacing-sm)}
.kpi b{display:block;font:var(--vds-font-numeric-bold-xl);color:var(--vds-text-regular)}
.kpi span{font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-regular-lighter)}
@media (min-width:760px){.kpis{grid-template-columns:repeat(4,1fr)}.kpi{border-right:var(--rule);padding-left:var(--vds-spacing-sm)}.kpi:first-child{padding-left:0}.kpi:last-child{border-right:0}}

/* ---------- waffle ---------- */
.wf{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:var(--vds-spacing-sm)}
.wf-h{text-align:center;min-height:68px}
.wf-h .big{font:var(--vds-font-numeric-bold-2xl);font-size:var(--display-num);color:var(--vds-text-regular);line-height:1.15}
.wf-h .sub{font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-subdued);margin-top:var(--vds-spacing-3xs)}
#waffle{width:min(100%,52vh,480px);height:auto;margin-top:var(--vds-spacing-sm)}
#waffle .b{fill:var(--c-track)}
#waffle .o{fill:var(--c-other);transform-box:fill-box;transform-origin:left center;transform:scaleX(0);transition:transform .5s ease}
#waffle.vn .o{fill:var(--c-vn)}
.key{display:flex;flex-wrap:wrap;gap:var(--vds-spacing-3xs) var(--vds-spacing-sm);justify-content:center;font:var(--vds-font-microcopy-label-regular-xsm);color:var(--vds-text-regular-lighter);margin-top:var(--vds-spacing-xs)}
.key span{display:flex;align-items:center;gap:var(--vds-spacing-3xs)}
.key i{width:var(--vds-spacing-xs);height:var(--vds-spacing-xs);display:inline-block}

/* ---------- tăng trưởng ---------- */
.growth{display:grid;gap:var(--vds-spacing-lg)}
@media (min-width:760px){.growth{grid-template-columns:1fr 1fr;gap:0}.growth>div+div{border-left:var(--rule);padding-left:var(--vds-spacing-md)}.growth>div{padding-right:var(--vds-spacing-md)}}
.growth h4{font:var(--vds-font-heading-sm);color:var(--vds-text-regular);margin:0}
.growth .cagr{font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-subdued)}
.gbars{display:flex;align-items:flex-end;gap:var(--vds-spacing-md);height:200px;margin-top:var(--vds-spacing-sm);border-bottom:var(--rule-black)}
.gbar{flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:stretch;height:100%}
.gbar .col{background:var(--c-other);height:0;transition:height 1.2s ease}
.gbar.f .col{background:var(--c-vn)}
.gbar .val{font:var(--vds-font-numeric-bold-lg);color:var(--vds-text-regular);margin-bottom:var(--vds-spacing-3xs);opacity:0;transition:opacity .4s .8s}
.gbars.in .val{opacity:1}
.gyr{display:flex;gap:var(--vds-spacing-md);margin-top:var(--vds-spacing-3xs)}.gyr span{flex:1;font:var(--vds-font-numeric-regular-sm);color:var(--vds-text-subdued)}
.mult{display:block;margin-top:var(--vds-spacing-xs);font:var(--vds-font-microcopy-label-bold-sm);color:var(--vds-text-accent-strong)}

/* ---------- phân khúc ---------- */
.segs{display:grid;grid-template-columns:repeat(2,1fr);border-top:var(--rule);margin:var(--vds-spacing-sm) 0 var(--vds-spacing-md)}
.segs div{padding:var(--vds-spacing-2xs) 0;border-bottom:var(--rule);font:var(--vds-font-microcopy-label-regular-md);color:var(--vds-text-regular);display:flex;justify-content:space-between;gap:var(--vds-spacing-2xs)}
.segs div:nth-child(odd){padding-right:var(--vds-spacing-sm);border-right:var(--rule)}
.segs div:nth-child(even){padding-left:var(--vds-spacing-sm)}
.segs .top{font:var(--vds-font-microcopy-label-bold-md)}
.segs .top em{font-style:normal;font-family:var(--vds-numeric-font-family);color:var(--c-vn)}
@media (min-width:760px){.segs{grid-template-columns:repeat(3,1fr)}.segs div:nth-child(odd),.segs div:nth-child(even){padding:var(--vds-spacing-2xs) var(--vds-spacing-sm);border-right:var(--rule)}.segs div:nth-child(3n+1){padding-left:0}.segs div:nth-child(3n){border-right:0}}

/* ---------- 50 điểm đến ---------- */
.grid50{display:grid;grid-template-columns:repeat(5,1fr);border-top:var(--rule-strong);border-left:var(--rule)}
@media (min-width:760px){.grid50{grid-template-columns:repeat(10,1fr)}}
.cell{appearance:none;border:0;border-right:var(--rule);border-bottom:var(--rule);background:transparent;padding:var(--vds-spacing-2xs) var(--vds-spacing-3xs);min-height:64px;text-align:left;cursor:pointer;display:flex;flex-direction:column;gap:var(--vds-spacing-4xs);transition:background .25s,opacity .25s;position:relative}
.cell .r{font:var(--vds-font-numeric-bold-sm);color:var(--vds-text-subdued)}
.cell .nm{font:var(--vds-font-microcopy-label-regular-xs);color:var(--vds-text-regular);line-height:1.3;overflow-wrap:anywhere}
.cell.on{background:var(--c-other-soft)}
.cell.on .r{color:var(--vds-text-support-regular)}
.cell.vn{background:var(--vds-surface-input-accent-selected);box-shadow:inset 0 0 0 var(--vds-component-divider-thickness-medium) var(--vds-border-accent-regular)}
.cell.vn .r,.cell.vn .nm{color:var(--vds-text-accent-strong);font-weight:700}
.cell.dim{opacity:.35}
.cell.sel{box-shadow:inset 0 0 0 var(--vds-component-divider-thickness-medium) var(--vds-border-strong)}
.cell.vn.sel{box-shadow:inset 0 0 0 var(--vds-component-divider-thickness-medium) var(--vds-border-accent-strong)}
.rank-info{min-height:52px;padding:var(--vds-spacing-xs) 0;border-bottom:var(--rule);font:var(--vds-font-article-paragraph-standard-regular-md);color:var(--vds-text-article-paragraph)}
.rank-info b{font:var(--vds-font-microcopy-label-bold-lg);color:var(--vds-text-regular)}

/* ---------- 4 yếu tố ---------- */
.factors{display:grid;grid-template-columns:1fr 1fr;border-top:var(--rule-black);margin:var(--vds-spacing-md) 0 var(--vds-spacing-lg)}
.factor{padding:var(--vds-spacing-sm) var(--vds-spacing-sm) var(--vds-spacing-md) 0;border-bottom:var(--rule)}
.factor:nth-child(odd){border-right:var(--rule)}
.factor:nth-child(even){padding-left:var(--vds-spacing-sm)}
.factor .no{font:var(--vds-font-numeric-regular-md);color:var(--vds-text-accent-strong)}
.factor b{display:block;font:var(--vds-font-microcopy-label-bold-lg);color:var(--vds-text-regular);margin-top:var(--vds-spacing-2xs)}
@media (min-width:760px){.factors{grid-template-columns:repeat(4,1fr)}.factor{border-bottom:0;border-right:var(--rule);padding-left:var(--vds-spacing-sm)}.factor:first-child{padding-left:0}.factor:last-child{border-right:0}}

/* ---------- ảnh ---------- */
.photo{margin:var(--vds-spacing-xl) auto;max-width:calc(var(--container) + 2 * var(--vds-spacing-margin-md));padding:0 var(--vds-spacing-margin-md)}
.photo img{width:100%;height:auto;border-radius:var(--vds-radii-sm);background:var(--vds-surface-200)}
.photo figcaption{font:var(--vds-font-article-paragraph-standard-regular-md);color:var(--vds-text-article-caption);padding-top:var(--vds-spacing-2xs);max-width:var(--measure)}
@media (max-width:760px){.photo{padding:0}.photo img{border-radius:0}.photo figcaption{padding-left:var(--vds-spacing-margin-md);padding-right:var(--vds-spacing-margin-md)}}

/* ---------- ông Akira ---------- */
.akira{display:flex;flex-wrap:wrap;align-items:center;gap:var(--vds-spacing-3xs);margin:var(--vds-spacing-2xs) 0}
.akira i{width:var(--vds-spacing-md);height:var(--vds-spacing-md);background:var(--c-other);opacity:0;transform:translateY(var(--vds-spacing-3xs));transition:.35s ease}
.akira.in i{opacity:1;transform:none}
.akira i.vn{background:var(--c-vn);width:auto;height:auto;padding:var(--vds-spacing-4xs) var(--vds-spacing-2xs);font:var(--vds-font-microcopy-label-bold-xs);font-style:normal;color:var(--vds-text-on-color-regular)}
.akira em{font-style:normal;font:var(--vds-font-microcopy-label-regular-xs);color:var(--vds-text-subdued);margin:0 var(--vds-spacing-3xs)}

/* ---------- biên niên ---------- */
.tl{border-top:var(--rule-black);margin:var(--vds-spacing-md) 0 var(--vds-spacing-lg);position:relative}
.ti{display:grid;grid-template-columns:104px 1fr;gap:var(--vds-spacing-sm);padding:var(--vds-spacing-sm) 0;border-bottom:var(--rule);position:relative}
.ti:before{content:"";position:absolute;left:0;top:-1px;width:0;height:var(--vds-component-divider-thickness-medium);background:var(--c-vn);transition:width .5s ease}
.ti.on:before{width:104px}
.ti .y{font:var(--vds-font-numeric-bold-sm);color:var(--vds-text-subdued);transition:color .3s}
.ti.on .y{color:var(--vds-text-accent-strong)}
.ti h4{margin:0 0 var(--vds-spacing-3xs);font:var(--vds-font-article-title-primary-bold-sm);color:var(--vds-text-article-title)}
.ti p{margin:0;font:var(--vds-font-article-paragraph-standard-regular-md);color:var(--vds-text-article-paragraph)}
@media (max-width:420px){.ti{grid-template-columns:1fr;gap:var(--vds-spacing-3xs)}.ti.on:before{width:64px}}

/* ---------- 2 cột số liệu ---------- */
.duo{display:grid;gap:var(--vds-spacing-lg);border-top:var(--rule-black);padding-top:var(--vds-spacing-sm);margin:var(--vds-spacing-lg) 0}
@media (min-width:760px){.duo{grid-template-columns:1fr 1fr;gap:0}.duo>div{padding-right:var(--vds-spacing-md)}.duo>div+div{border-left:var(--rule);padding-left:var(--vds-spacing-md);padding-right:0}}
.duo h4{margin:0 0 var(--vds-spacing-xs);font:var(--vds-font-heading-sm);color:var(--vds-text-regular)}
.duo p{margin:var(--vds-spacing-xs) 0 0;font:var(--vds-font-article-paragraph-standard-regular-md);color:var(--vds-text-article-paragraph)}
.share{display:flex;align-items:baseline;gap:var(--vds-spacing-xs)}
.share b{font:var(--vds-font-numeric-bold-2xl);font-size:var(--display-num);color:var(--c-vn);line-height:1}
.sbar{height:var(--vds-spacing-md);background:var(--c-track);margin-top:var(--vds-spacing-xs);position:relative}
.sbar i{position:absolute;inset:0 auto 0 0;width:0;background:var(--c-vn);transition:width 1.2s ease}
.people{display:grid;grid-template-columns:repeat(20,1fr);gap:var(--vds-spacing-4xs)}
.people i{aspect-ratio:1;background:var(--c-track);transition:background .35s}
.people.in i.c{background:var(--c-vn)}

/* ---------- đơn vị 2.107 ---------- */
#units{position:absolute;inset:0;width:100%;height:100%}
.uh{position:absolute;left:0;right:0;top:var(--vds-spacing-xs);text-align:center;z-index:1;pointer-events:none}
.uh .big{font:var(--vds-font-numeric-bold-2xl);font-size:var(--display-num);color:var(--vds-text-regular);line-height:1.1}
.uh .sub{font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-subdued)}
.ua{position:absolute;inset:96px var(--vds-spacing-sm) var(--vds-spacing-xs)}
.stats{display:grid;grid-template-columns:1fr 1fr;border-top:var(--rule-black);margin:var(--vds-spacing-lg) 0 0}
.stats div{padding:var(--vds-spacing-sm) var(--vds-spacing-sm) var(--vds-spacing-sm) 0;border-bottom:var(--rule)}
.stats div:nth-child(odd){border-right:var(--rule)}
.stats div:nth-child(even){padding-left:var(--vds-spacing-sm)}
.stats b{display:block;font:var(--vds-font-numeric-bold-xl);color:var(--vds-text-regular)}
.stats span{font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-regular-lighter)}
@media (min-width:760px){.stats{grid-template-columns:repeat(4,1fr)}.stats div{border-bottom:0;border-right:var(--rule);padding-left:var(--vds-spacing-sm)}.stats div:first-child{padding-left:0}.stats div:last-child{border-right:0}}

/* ---------- thời gian chờ, chi phí ---------- */
.weeks{display:grid;grid-template-columns:repeat(13,1fr);gap:var(--vds-spacing-4xs);margin:var(--vds-spacing-2xs) 0 var(--vds-spacing-xs)}
.weeks i{aspect-ratio:1;background:var(--c-track);transition:background .2s}
.weeks.home i.f{background:var(--c-other)}
.weeks.vn i.f{background:var(--c-vn)}
.wl{display:flex;justify-content:space-between;font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-regular-lighter)}
.wl b{font:var(--vds-font-microcopy-label-bold-sm);color:var(--vds-text-regular)}
.range{width:100%;accent-color:var(--vds-text-accent-strong);height:var(--vds-spacing-xl);margin:var(--vds-spacing-2xs) 0}
.cr{display:grid;grid-template-columns:110px 1fr;align-items:center;gap:var(--vds-spacing-2xs);margin-top:var(--vds-spacing-2xs);font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-regular-lighter)}
.cr .tr{height:var(--vds-spacing-lg);background:var(--c-track);position:relative}
.cr .tr i{position:absolute;top:0;bottom:0;left:0}
.cr .tr i.a{width:100%;background:var(--c-other)}
.cr .tr i.b{width:30%;background:var(--c-vn)}
.cr .tr i.b2{width:50%;background:var(--vds-surface-input-accent-selected)}
.cr .tr em{position:absolute;right:var(--vds-spacing-2xs);top:50%;transform:translateY(-50%);font-style:normal;font:var(--vds-font-numeric-bold-sm);color:var(--vds-text-regular)}
.cr .tr i.a+em{color:var(--vds-text-on-color-regular)}
.fine{font:var(--vds-font-microcopy-label-regular-xsm);color:var(--vds-text-subdued);margin-top:var(--vds-spacing-xs)}

/* ---------- tab bệnh viện ---------- */
.hpanel{padding:var(--vds-spacing-md) 0 0}
.hpanel .who{font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-subdued);margin:0 0 var(--vds-spacing-sm)}
.hpanel dl{display:grid;grid-template-columns:1fr;margin:0;border-top:var(--rule)}
.hpanel dl div{display:grid;grid-template-columns:120px 1fr;gap:var(--vds-spacing-sm);padding:var(--vds-spacing-xs) 0;border-bottom:var(--rule)}
.hpanel dt{font:var(--vds-font-microcopy-label-bold-sm);color:var(--vds-text-regular)}
.hpanel dd{margin:0;font:var(--vds-font-article-paragraph-standard-regular-md);color:var(--vds-text-article-paragraph)}
.hpanel blockquote{margin:var(--vds-spacing-md) 0 0;font:var(--vds-font-article-title-primary-regular-sm);color:var(--vds-text-article-title)}
@media (max-width:420px){.hpanel dl div{grid-template-columns:1fr;gap:var(--vds-spacing-4xs)}}

/* ---------- bản đồ JCI ---------- */
.jci{display:grid;gap:var(--vds-spacing-md)}
@media (min-width:860px){.jci{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0}.jci .mapbox{border-right:var(--rule);padding-right:var(--vds-spacing-md)}.jci .side{padding-left:var(--vds-spacing-md)}}
.jci .mapbox{position:relative;aspect-ratio:.8;max-height:640px;width:100%}
.mapsvg .bub{fill:var(--c-vn);stroke:var(--vds-surface-paper-000);stroke-width:1.5;vector-effect:non-scaling-stroke;transition:fill .25s}
.mapsvg .bub.sel{fill:var(--vds-text-regular)}
.mapsvg .bub.sel+.bn{fill:var(--vds-surface-000)}
.mapsvg .bn{font-family:var(--vds-numeric-font-family);font-weight:700;fill:var(--vds-text-on-color-regular);font-size:var(--vds-numeric-font-size-md);text-anchor:middle;dominant-baseline:central;pointer-events:none}
.mapsvg .bl{font-weight:700;fill:var(--vds-text-regular);font-size:var(--vds-microcopy-label-font-size-sm);pointer-events:none;paint-order:stroke;stroke:var(--vds-surface-paper-000);stroke-width:3px}
.mapsvg .lead-dot{fill:var(--c-vn)}
.mapsvg .lead-l{stroke:var(--c-vn);stroke-width:1;stroke-dasharray:2 3;vector-effect:non-scaling-stroke}
.hlist{list-style:none;margin:var(--vds-spacing-sm) 0 0;padding:0;border-top:var(--rule)}
.hlist li{display:grid;grid-template-columns:var(--vds-spacing-lg) 1fr;padding:var(--vds-spacing-2xs) 0;border-bottom:var(--rule);font:var(--vds-font-microcopy-label-regular-md);color:var(--vds-text-regular)}
.hlist li i{font-style:normal;font:var(--vds-font-numeric-regular-sm);color:var(--vds-text-subdued)}
.hlist li small{display:block;font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-accent-strong)}

/* ---------- bảng thiếu sót ---------- */
.gaps{border-top:var(--rule-black);margin:var(--vds-spacing-md) 0 var(--vds-spacing-lg)}
.gap-r{display:grid;grid-template-columns:1fr auto;gap:var(--vds-spacing-sm);align-items:baseline;padding:var(--vds-spacing-xs) 0;border-bottom:var(--rule);font:var(--vds-font-microcopy-label-regular-lg);color:var(--vds-text-regular)}
.gap-r small{display:block;font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-subdued)}
.gap-r .st{font:var(--vds-font-microcopy-label-bold-sm);white-space:nowrap}
.st.miss{color:var(--vds-text-negative-regular)}
.st.lim{color:var(--vds-text-warning-regular)}

/* ---------- so sánh ---------- */
.crow{display:grid;grid-template-columns:116px 1fr;gap:var(--vds-spacing-xs);align-items:center;padding:var(--vds-spacing-2xs) 0;border-bottom:var(--rule)}
.crow .c{font:var(--vds-font-microcopy-label-bold-md);color:var(--vds-text-regular);display:flex;align-items:center;gap:var(--vds-spacing-2xs)}
.crow .c svg{width:var(--vds-spacing-md);height:var(--vds-spacing-md);flex:none}
.crow .tr{position:relative;height:var(--vds-spacing-lg)}
.crow .fl{position:absolute;left:0;top:0;bottom:0;background:var(--c-other);transition:width .8s ease}
.crow.vn .fl{background:var(--c-vn)}
.crow .vl{position:absolute;top:50%;transform:translateY(-50%);font:var(--vds-font-numeric-bold-sm);white-space:nowrap;transition:left .8s ease;color:var(--vds-text-regular)}
.crow .vl.in{color:var(--vds-text-on-color-regular)}
.crow .axis{position:absolute;left:0;right:0;top:50%;border-top:var(--rule-strong)}
.crow .rk{position:absolute;top:50%;width:var(--vds-spacing-sm);height:var(--vds-spacing-sm);margin:calc(-1 * var(--vds-spacing-2xs)) 0 0 calc(-1 * var(--vds-spacing-2xs));border-radius:var(--vds-radii-circle);background:var(--c-other);transition:left .8s ease}
.crow.vn .rk{background:var(--c-vn)}
.ins{padding:var(--vds-spacing-xs) 0;font:var(--vds-font-article-paragraph-standard-regular-md);color:var(--vds-text-article-paragraph);min-height:72px}

/* ---------- visa ---------- */
.vgrid{display:grid;grid-template-columns:1fr 1fr;border-top:var(--rule-black);margin-top:var(--vds-spacing-sm)}
.vgrid .vh{display:flex;align-items:center;gap:var(--vds-spacing-2xs);padding:var(--vds-spacing-xs) var(--vds-spacing-xs) var(--vds-spacing-xs) 0;font:var(--vds-font-microcopy-label-bold-md);color:var(--vds-text-regular);border-bottom:var(--rule-strong)}
.vgrid .vh svg{width:var(--vds-spacing-md);height:var(--vds-spacing-md)}
.vgrid .vh.b{padding-left:var(--vds-spacing-xs);border-left:var(--rule);color:var(--vds-text-accent-strong)}
.vgrid .rt{grid-column:1/-1;font:var(--vds-font-microcopy-label-bold-xs);color:var(--vds-text-subdued);padding:var(--vds-spacing-xs) 0 0;text-transform:uppercase;letter-spacing:.06em}
.vgrid .vc{padding:var(--vds-spacing-3xs) var(--vds-spacing-xs) var(--vds-spacing-xs) 0;border-bottom:var(--rule);font:var(--vds-font-article-paragraph-standard-regular-sm);color:var(--vds-text-article-paragraph)}
.vgrid .vc.b{padding-left:var(--vds-spacing-xs);border-left:var(--rule)}
.vgrid .vc .p{display:block;font:var(--vds-font-microcopy-label-bold-sm);color:var(--vds-text-support-regular);margin-bottom:var(--vds-spacing-3xs)}
.vgrid .vc.b .p{color:var(--vds-text-accent-strong)}

/* ---------- ma trận phối hợp ---------- */
.mx{width:100%;border-collapse:collapse;margin-top:var(--vds-spacing-sm);font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-regular)}
.mx th,.mx td{border-bottom:var(--rule);padding:var(--vds-spacing-2xs) var(--vds-spacing-3xs);text-align:center}
.mx thead th{font:var(--vds-font-microcopy-label-bold-xs);color:var(--vds-text-regular-lighter);border-bottom:var(--rule-strong);vertical-align:bottom}
.mx tbody th{text-align:left;font:var(--vds-font-microcopy-label-bold-sm);padding-left:0}
.mx td{color:var(--vds-text-subdued-lighter);font:var(--vds-font-numeric-bold-md)}
.mx tbody tr:hover td{color:var(--vds-text-accent-strong);background:var(--vds-surface-100)}

/* ---------- hành trình ---------- */
.jbar{position:sticky;top:var(--header-h);z-index:5;background:var(--vds-surface-paper-000);border-bottom:var(--rule-strong);padding:var(--vds-spacing-2xs) 0}
.jbar .in{max-width:calc(900px + 2 * var(--vds-spacing-margin-md));margin:0 auto;padding:0 var(--vds-spacing-margin-md)}
.jdots{display:flex;align-items:center}
.jdots i{flex:none;width:var(--vds-spacing-2xs);height:var(--vds-spacing-2xs);border-radius:var(--vds-radii-circle);background:var(--vds-surface-300);transition:background .3s}
.jdots i.on{background:var(--c-vn)}
.jdots u{flex:1;height:var(--vds-component-divider-thickness-regular);background:var(--vds-component-divider-fill-regular);text-decoration:none;position:relative}
.jdots u:after{content:"";position:absolute;inset:0;background:var(--c-vn);transform:scaleX(0);transform-origin:left;transition:transform .35s}
.jdots u.on:after{transform:none}
.jcap{display:flex;justify-content:space-between;margin-top:var(--vds-spacing-3xs);font:var(--vds-font-microcopy-label-bold-sm);color:var(--vds-text-regular)}
.jcap em{font-style:normal;font:var(--vds-font-numeric-regular-sm);color:var(--vds-text-subdued)}
.stn{display:grid;grid-template-columns:48px 1fr;gap:var(--vds-spacing-sm);padding:var(--vds-spacing-md) 0;border-bottom:var(--rule)}
.stn .no{font:var(--vds-font-numeric-bold-xl);color:var(--vds-text-subdued-lighter);transition:color .3s}
.stn.on .no{color:var(--vds-text-accent-strong)}
.stn h4{margin:0 0 var(--vds-spacing-xs);font:var(--vds-font-article-title-primary-bold-md);color:var(--vds-text-article-title)}
.side2{display:grid;gap:var(--vds-spacing-xs)}
@media (min-width:760px){.side2{grid-template-columns:1fr 1fr;gap:0}.side2>div{padding-right:var(--vds-spacing-sm)}.side2>div+div{border-left:var(--rule);padding-left:var(--vds-spacing-sm);padding-right:0}}
.sd{font:var(--vds-font-article-paragraph-standard-regular-md);color:var(--vds-text-article-paragraph)}
.sd .who{display:flex;align-items:center;gap:var(--vds-spacing-2xs);font:var(--vds-font-microcopy-label-bold-sm);color:var(--vds-text-support-regular);margin-bottom:var(--vds-spacing-3xs)}
.sd .who svg{width:var(--vds-spacing-sm);height:var(--vds-spacing-sm)}
.sd.vn .who{color:var(--vds-text-accent-strong)}
.sd.na{color:var(--vds-text-subdued);font:var(--vds-font-microcopy-label-regular-sm)}
.mhtc{display:grid;grid-template-columns:repeat(3,1fr);border-top:var(--rule-black);border-bottom:var(--rule);margin:var(--vds-spacing-md) 0}
.mhtc div{padding:var(--vds-spacing-sm) var(--vds-spacing-xs) var(--vds-spacing-sm) 0}
.mhtc div+div{border-left:var(--rule);padding-left:var(--vds-spacing-xs)}
.mhtc b{display:block;font:var(--vds-font-numeric-bold-2xl);color:var(--vds-text-regular)}
.mhtc span{font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-regular-lighter)}

/* ---------- kết ---------- */
.finale{border-top:var(--vds-component-divider-thickness-thick) solid var(--vds-component-divider-fill-subdued);margin-top:var(--vds-spacing-4xl);padding:var(--vds-spacing-3xl) 0 var(--vds-spacing-2xl)}
.finale blockquote{margin:0;font:var(--vds-font-article-title-primary-regular-xl);font-size:var(--display-title);line-height:1.35;color:var(--vds-text-article-title);max-width:20em}
.finale blockquote b{font-weight:900;color:var(--vds-text-accent-strong)}
.finale cite{display:block;margin-top:var(--vds-spacing-md);font-style:normal;font:var(--vds-font-microcopy-label-regular-md);color:var(--vds-text-subdued)}
.finale cite b{color:var(--vds-text-regular)}
.credits{background:var(--vds-surface-100);border-top:var(--rule-strong);padding:var(--vds-spacing-xl) 0 calc(var(--vds-spacing-3xl) + env(safe-area-inset-bottom));font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-regular-lighter)}
.credits .wide{display:grid;gap:var(--vds-spacing-md)}
@media (min-width:760px){.credits .wide{grid-template-columns:1fr 2fr}}
.credits h5{margin:0 0 var(--vds-spacing-2xs);font:var(--vds-font-heading-xs);color:var(--vds-text-regular)}
.credits b{color:var(--vds-text-regular)}

/* ---------- chế độ sửa ---------- */
html.editing [data-e],html.editing [data-c]{outline:var(--vds-component-divider-thickness-regular) dashed transparent;outline-offset:var(--vds-spacing-4xs);cursor:text;transition:outline-color .15s}
html.editing [data-e]:hover,html.editing [data-c]:hover{outline-color:var(--vds-border-info-regular)}
html.editing [data-e]:focus,html.editing [data-c]:focus{outline:var(--vds-component-divider-thickness-medium) solid var(--vds-border-focus);background:var(--vds-surface-info)}
html.editing [data-dirty]{box-shadow:inset var(--vds-spacing-4xs) 0 0 var(--vds-border-warning-regular)}
html.editing .rv{opacity:1;transform:none}
#edbar{position:fixed;left:50%;bottom:var(--vds-spacing-sm);transform:translateX(-50%);z-index:80;background:var(--vds-surface-000);border:var(--rule-strong);border-radius:var(--vds-radii-lg);box-shadow:var(--vds-shadow-elavation-B);padding:var(--vds-spacing-2xs) var(--vds-spacing-2xs) var(--vds-spacing-2xs) var(--vds-spacing-sm);display:flex;align-items:center;gap:var(--vds-spacing-2xs);max-width:calc(100vw - 2 * var(--vds-spacing-sm));font:var(--vds-font-microcopy-label-regular-sm);color:var(--vds-text-regular)}
#edbar .msg{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-right:var(--vds-spacing-2xs)}
#edbar .msg b{font-weight:700}
#edpanel{position:fixed;right:0;top:0;bottom:0;width:min(440px,100vw);z-index:79;background:var(--vds-surface-000);border-left:var(--rule-strong);box-shadow:var(--vds-shadow-elavation-B);transform:translateX(100%);transition:transform .3s;display:flex;flex-direction:column}
#edpanel.open{transform:none}
#edpanel header{display:flex;align-items:center;justify-content:space-between;padding:var(--vds-spacing-xs) var(--vds-spacing-xs) var(--vds-spacing-xs) var(--vds-spacing-sm);border-bottom:var(--rule-strong);font:var(--vds-font-heading-sm);color:var(--vds-text-regular)}
#edpanel .body{overflow:auto;padding:0 var(--vds-spacing-sm) 120px}
#edpanel .grp{font:var(--vds-font-microcopy-label-bold-sm);color:var(--vds-text-accent-strong);padding:var(--vds-spacing-md) 0 var(--vds-spacing-3xs);border-bottom:var(--rule-strong)}
#edpanel label{display:block;padding:var(--vds-spacing-2xs) 0;border-bottom:var(--rule)}
#edpanel label span{display:block;font:var(--vds-font-microcopy-label-regular-xs);color:var(--vds-text-subdued);margin-bottom:var(--vds-spacing-4xs)}
#edpanel textarea{width:100%;min-height:40px;resize:vertical;border:var(--rule-strong);border-radius:var(--vds-radii-sm);background:var(--vds-surface-100);color:var(--vds-text-regular);font:var(--vds-font-microcopy-label-regular-md);padding:var(--vds-spacing-3xs) var(--vds-spacing-2xs)}
#edtoast{position:fixed;left:50%;bottom:calc(var(--vds-spacing-sm) + 64px);transform:translateX(-50%);z-index:81;width:min(420px,calc(100vw - 2 * var(--vds-spacing-sm)))}
#edtoast[hidden],#edbar[hidden],#edpanel[hidden],#edtoast [hidden]{display:none}
</style>
</head>
<body>
<a class="sr" href="#c0">Bỏ qua phần mở đầu</a>

<header id="bar">
  <div class="in">
    <a class="logo" href="https://vnexpress.net" aria-label="VnExpress"><svg width="150" height="28" viewBox="0 0 150 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="VnExpress" data-vds-logo="Logo__VnExpress__Standard" role="img" focusable="false"><g><path d="M147.556 10.319H140.109V12.7065H147.192C148.291 12.7065 149.024 12.8856 149.449 13.2434C149.817 13.6025 150 14.3185 150 15.3336V16.8265C150 17.8399 149.817 18.5563 149.449 18.9154C149.024 19.2736 148.291 19.4528 147.192 19.4528H140.17C139.071 19.4528 138.279 19.2736 137.91 18.9154C137.481 18.5563 137.301 17.8399 137.301 16.8265V16.527L139.623 16.0501V17.363H147.679V14.8559H140.597C139.499 14.8559 138.764 14.6768 138.339 14.259C137.972 13.8999 137.788 13.2434 137.788 12.2288V10.9754C137.788 9.96075 137.972 9.30387 138.339 8.94564C138.764 8.52742 139.499 8.34875 140.597 8.34875H147.069C148.108 8.34875 148.839 8.52742 149.267 8.88564C149.694 9.24387 149.879 9.90075 149.879 10.7954V11.0354L147.556 11.5719V10.319Z" style="fill:var(--vds-component-logo-vnexpress-standard-secondary, #7f7f7f)"/><path d="M132.507 10.319H125.058V12.7065H132.142C133.24 12.7065 134.034 12.8856 134.401 13.2434C134.826 13.6025 135.011 14.3185 135.011 15.3336V16.8265C135.011 17.8399 134.826 18.5563 134.401 18.9154C134.034 19.2736 133.24 19.4528 132.142 19.4528H125.121C124.02 19.4528 123.29 19.2736 122.86 18.9154C122.495 18.5563 122.311 17.8399 122.311 16.8265V16.527L124.633 16.0501V17.363H132.631V14.8559H125.547C124.449 14.8559 123.717 14.6768 123.35 14.259C122.921 13.8999 122.737 13.2434 122.737 12.2288V10.9754C122.737 9.96075 122.921 9.30387 123.35 8.94564C123.717 8.52742 124.449 8.34875 125.547 8.34875H132.019C133.118 8.34875 133.851 8.52742 134.218 8.88564C134.643 9.24387 134.826 9.90075 134.826 10.7954V11.0354L132.507 11.5719V10.319Z" style="fill:var(--vds-component-logo-vnexpress-standard-secondary, #7f7f7f)"/><path d="M108.316 19.4528V8.34875H119.978V10.259H111.002V12.7065H116.253V14.6168H111.002V17.363H120.1V19.4528H108.316Z" style="fill:var(--vds-component-logo-vnexpress-standard-secondary, #7f7f7f)"/><path d="M92.8647 19.4528V8.34875H102.575C103.492 8.34875 104.162 8.52742 104.588 8.88564C104.956 9.18387 105.201 9.78075 105.201 10.4981V13.1243C105.201 13.8999 104.956 14.4385 104.588 14.7368C104.162 15.0945 103.492 15.2736 102.575 15.2736H101.109L106.362 19.4528H102.575L97.9952 15.2736H95.4893V19.4528H92.8647ZM101.415 10.259H95.4893V13.3634H101.415C101.902 13.3634 102.209 13.303 102.391 13.1848C102.513 13.0648 102.637 12.8256 102.637 12.4683V11.1541C102.637 10.8554 102.513 10.6163 102.391 10.4981C102.209 10.319 101.902 10.259 101.415 10.259Z" style="fill:var(--vds-component-logo-vnexpress-standard-secondary, #7f7f7f)"/><path d="M78.3143 19.4528V8.34875H88.0857C88.9398 8.34875 89.6121 8.52742 90.038 8.88564C90.4048 9.18387 90.6498 9.78075 90.6498 10.4981V13.0052C90.6498 13.7221 90.4048 14.3185 90.038 14.6168C89.6121 14.9754 88.9398 15.1536 88.0857 15.1536H80.9398V19.4528H78.3143ZM86.8639 10.259H80.9398V13.243H86.8639C87.3516 13.243 87.6575 13.1848 87.8416 13.0052C87.9639 12.8856 88.0857 12.6465 88.0857 12.3483V11.1541C88.0857 10.8554 87.9639 10.6163 87.8416 10.4981C87.6575 10.319 87.3516 10.259 86.8639 10.259Z" style="fill:var(--vds-component-logo-vnexpress-standard-secondary, #7f7f7f)"/><path d="M61.1093 19.4528L66.4825 13.7812L60.9871 8.34875H64.5289L68.133 12.1092L71.6116 8.34875H74.603L69.6584 13.4825L75.8253 19.4528H72.2225L68.0721 15.1536L64.2234 19.4528H61.1093Z" style="fill:var(--vds-component-logo-vnexpress-standard-secondary, #7f7f7f)"/><g><path d="M58.2162 26.6667C58.2162 27.4031 57.6057 28 56.8526 28H34.1252C33.3721 28 32.7616 27.4031 32.7616 26.6667V1.33333C32.7616 0.596889 33.3721 0 34.1252 0H56.8526C57.6057 0 58.2162 0.596889 58.2162 1.33333V26.6667Z" style="fill:var(--vds-component-logo-vnexpress-standard-primary, #9f224e)"/><path d="M40.9434 10.7135V11.158V12.0002H42.532H47.3071V16.0002H42.532H40.9434V16.9357V17.3802V18.2691V19.6024V20.8891H42.532H54.5798V24.4446H41.9843H36.3979V3.55575H41.9843H54.5798V7.1113H42.532H40.9434V8.4913V9.82463V10.7135ZM42.307 8.44463H54.7116C55.4643 8.44463 55.9434 7.89397 55.9434 7.15797V3.60241C55.9434 2.86641 55.4643 2.22241 54.7116 2.22241H41.9843H36.5298C35.7766 2.22241 35.0343 2.86641 35.0343 3.60241V24.4913C35.0343 25.2273 35.7766 25.778 36.5298 25.778H41.9843H54.7116C55.4643 25.778 55.9434 25.2273 55.9434 24.4913V20.9357C55.9434 20.1997 55.4643 19.5557 54.7116 19.5557H42.307V18.2691V17.3335H47.4389C48.1916 17.3335 48.6707 16.7829 48.6707 16.0469V12.0469C48.6707 11.3109 48.1916 10.6669 47.4389 10.6669H42.307V9.82463V8.44463Z" style="fill:var(--vds-component-logo-vnexpress-negative, #ffffff)"/></g><path d="M16.726 19.4528V8.34875H18.4964L26.4946 14.9154C26.8005 15.1536 27.046 15.3332 27.2283 15.5128C27.4728 15.6914 27.6555 15.9301 27.8392 16.1101C27.7778 15.5128 27.716 15.0345 27.716 14.7968V14.1985V8.34875H30.0983V19.4528H28.2673L19.9005 12.5874C19.7187 12.4083 19.5346 12.2888 19.4123 12.1092C19.2287 11.9901 19.1091 11.871 18.9864 11.6919C19.0473 12.0496 19.0473 12.3483 19.0473 12.7065C19.1091 13.0052 19.1091 13.243 19.1091 13.4825V19.4528H16.726Z" style="fill:var(--vds-component-logo-vnexpress-standard-secondary, #7f7f7f)"/><path d="M6.59501 19.4528L0 8.34875H3.05319L7.63274 16.4079L12.0287 8.34875H14.6541L8.42638 19.4528H6.59501Z" style="fill:var(--vds-component-logo-vnexpress-standard-secondary, #7f7f7f)"/></g></svg></a>
    <span class="vds-divider-vertical" aria-hidden="true"></span>
    <a class="cat" href="https://vnexpress.net/du-lich">Du lịch</a>
    <span class="ch" id="chName" data-noedit>Mở đầu</span>

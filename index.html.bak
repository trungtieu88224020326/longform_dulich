/**
 * VnExpress Design System - effect styles (shadow)
 * Tự sinh từ packages/tokens/figma - KHÔNG sửa tay. Chạy `npm run build -w @vnexpress/tokens`.
 */

:root {
  --vds-shadow-elavation-A: 0px 0px 0px 0px #0000000d, 0px 16px 35px 0px #0000000d, 0px 63px 63px 0px #0000000a, 0px 142px 85px 0px #00000008, 0px 252px 101px 0px #00000003, 0px 394px 110px 0px #00000000;
  --vds-shadow-elavation-B: 0px 4px 9px 0px #00000012, 0px 17px 17px 0px #0000000f, 0px 39px 23px 0px #0000000a, 0px 69px 28px 0px #00000003, 0px 108px 30px 0px #00000000;
  --vds-shadow-component-card: 0px 2px 4px 0px #0000001c, 0px 8px 8px 0px #0000001a, 0px 18px 11px 0px #0000000f, 0px 33px 13px 0px #00000005, 0px 51px 14px 0px #00000000;
  --vds-shadow-component-icon: 1px 1px 4px 0px #00000066;
  --vds-shadow-component-toggle: 0px 3px 1px 0px #0000000f, 0px 3px 8px 0px #00000026;
  --vds-shadow-component-widget: 0px 4px 16px 0px #ead9ca;
  --vds-shadow-component-subscriptions: 0px 4px 12px 4px #9f224e4d;
  --vds-shadow-component-textfield-focus: 0px 0px 8px 0px #4290d980;
}
</style>
<style id="vds-components-css">/*
 * VnExpress Design System 0.5.0: CSS của component.

(function(){const items=$$('#tl .ti');let t=false;function upd(){t=false;const mid=innerHeight*.62;items.forEach(it=>it.classList.toggle('on',it.getBoundingClientRect().top<mid))}
  addEventListener('scroll',()=>{if(!t){t=true;requestAnimationFrame(upd)}},{passive:true});upd()})();


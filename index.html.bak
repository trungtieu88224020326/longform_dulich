,"\" class=\"vds-input-text-field__input\"",{"if":"error","do":[" aria-invalid=\"true\""]},{"p":"described"},{"if":"disabled","do":[" disabled"]}," data-vds-rest>",{"if":"content","do":["<span class=\"vds-input-text-field__trailing\">",{"r":"content"},"</span>"]},"</div>",{"if":"error","do":["<vds-alert-inline id=\"",{"v":"id"},"-note\" context=\"negative\">",{"v":"error"},"</vds-alert-inline>"]},{"if":"error","not":true,"do":[{"if":"helper","do":["<p id=\"",{"v":"id"},"-note\" class=\"vds-input-text-field__helper\">",{"v":"helper"},"</p>"]}]},"</div>"],"described":[{"if":"error","do":[" aria-describedby=\"",{"v":"id"},"-note\""]},{"if":"error","not":true,"do":[{"if":"helper","do":[" aria-describedby=\"",{"v":"id"},"-note\""]}]}]}},"vds-selection-item-chip":{"props":{"size":{"figma":"Size","default":"md","values":{"sm":"Small (32px)","md":"Medium (40px)","lg":"Large (48px)"}},"selected":{"figma":"State = Selected","boolean":true},"icon":{"figma":"Icon = True","icon":true,"note":"Icon 24px trước nhãn"},"role":{"values":{"radio":"Chip trong nhóm chọn một (`role=\"radiogroup\"`)"},"note":"Không có: chip bật tắt"},"disabled":{"boolean":true},"type":{"default":"button","note":"`type` của thẻ `button`"}},"figma":"Selection__Item__Chip","content":"Nhãn","parts":{"main":["<button type=\"",{"v":"type"},"\"",{"if":"role","do":[" role=\"",{"v":"role"},"\""]}," class=\"vds-selection-item-chip vds-state-layer vds-focus-ring",{"if":"size","not":true,"in":["md"],"do":[" vds-selection-item-chip--",{"v":"size"}]},{"if":"selected","do":[" vds-selection-item-chip--selected"]},"\"",{"p":"state"},{"if":"disabled","do":[" disabled"]},">",{"if":"icon","do":["<span class=\"vds-selection-item-chip__icon\" aria-hidden=\"true\"><vds-icon name=\"",{"v":"icon"},"\" size=\"24\"></vds-icon></span>"]},{"r":"content"},"</button>"],"state":[{"if":"role","in":["radio"],"do":[" aria-checked=\"",{"if":"selected","do":["true"]},{"if":"selected","not":true,"do":["false"]},"\" tabindex=\"",{"if":"selected","do":["0"]},{"if":"selected","not":true,"do":["-1"]},"\""]},{"if":"role","not":true,"in":["radio"],"do":[" aria-pressed=\"",{"if":"selected","do":["true"]},{"if":"selected","not":true,"do":["false"]},"\""]}]}},"vds-tab":{"props":{"selected":{"figma":"State = Selected","boolean":true,"note":"Đúng một tab"},"disabled":{"figma":"State = Disabled","boolean":true},"panel":{"note":"`id` của vùng nội dung tab điều khiển (`aria-controls`)"}},"figma":"_Tabs__Item","content":"Nhãn tab","parts":{"main":["<button type=\"button\" role=\"tab\" class=\"vds-tabs__item\" aria-selected=\"",{"if":"selected","do":["true"]},{"if":"selected","not":true,"do":["false"]},"\"",{"if":"panel","do":[" aria-controls=\"",{"v":"panel"},"\""]}," tabindex=\"",{"if":"selected","do":["0"]},{"if":"selected","not":true,"do":["-1"]},"\"",{"if":"disabled","do":[" disabled"]},"><span class=\"vds-tabs__label\" data-text=\"",{"v":"text"},"\"><span>",{"r":"content"},"</span></span></button>"]}},"vds-tabs":{"props":{"width":{"figma":"Width","default":"hug","values":{"hug":"Hug (mỗi tab vừa nhãn)","fixed":"Fixed (chia đều bề ngang)"}}},"figma":"Tabs","content":"Các thẻ vds-tab","parts":{"main":["<div class=\"vds-tabs",{"if":"width","in":["fixed"],"do":[" vds-tabs--fixed"]},"\" role=\"tablist\">",{"r":"content"},"</div>"]}},"vds-user-avatar":{"props":{"size":{"figma":"Size","default":"24","values":{"20":"20","24":"24","32":"32"}},"src":{"figma":"Has profile image = True","note":"Đường dẫn ảnh; không có thì hiện chữ cái `initial`"},"initial":{"figma":"Has profile image = False","note":"Chữ cái đầu của tên, tự viết hoa"},"alt":{"note":"Tên cho trình đọc màn hình khi avatar đứng riêng; bỏ trống khi avatar nằm cạnh tên hoặc trong nút có nhãn"},"unread":{"figma":"Unread badge","boolean":true,"note":"Chấm báo có thông báo chưa đọc"}},"figma":"UserAvatar","parts":{"main":["<span class=\"vds-user-avatar",{"if":"size","not":true,"in":["24"],"do":[" vds-user-avatar--",{"v":"size"}]},{"if":"unread","do":[" vds-user-avatar--unread"]},"\"",{"if":"alt","do":[" role=\"img\" aria-label=\"",{"v":"alt"},"\""]},">",{"if":"src","do":["<img class=\"vds-user-avatar__face\" src=\"",{"v":"src"},"\" alt=\"\">"]},{"if":"src","not":true,"do":["<span class=\"vds-user-avatar__face\" aria-hidden=\"true\">",{"v":"initial"},"</span>"]},"</span>"]}}}} })
  const script = document.currentScript
  if (script) configure({ assets: script.dataset.vdsAssets || (script.src && new URL('../', script.src).href) })
window.VDS = { init, configure, renderTags }
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => init())
else init()
})()

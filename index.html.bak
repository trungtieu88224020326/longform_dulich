/**
 * VnExpress Design System - text styles (composite typography)
 * Tự sinh từ packages/tokens/figma - KHÔNG sửa tay. Chạy `npm run build -w @vnexpress/tokens`.
 */

:root {
  --vds-font-article-title-primary-regular-xs: 400 var(--vds-article-title-primary-font-size-xs)/1.6 var(--vds-article-title-primary-font-family);
  --vds-font-article-title-primary-regular-sm: 400 var(--vds-article-title-primary-font-size-sm)/1.6 var(--vds-article-title-primary-font-family);
  --vds-font-article-title-primary-regular-smd: 400 var(--vds-typography-font-size-700)/1.6 var(--vds-article-title-primary-font-family);
  --vds-font-article-title-primary-regular-md: 400 var(--vds-article-title-primary-font-size-md)/1.6 var(--vds-article-title-primary-font-family);
  --vds-font-article-title-primary-regular-mlg: 400 var(--vds-typography-font-size-1200)/1.6 var(--vds-article-title-primary-font-family);
  --vds-font-article-title-primary-regular-lg: 400 var(--vds-article-title-primary-font-size-lg)/1.6 var(--vds-article-title-primary-font-family);
  --vds-font-article-title-primary-regular-xl: 400 var(--vds-article-title-primary-font-size-xl)/1.6 var(--vds-article-title-primary-font-family);
  --vds-font-article-title-primary-bold-xs: 700 var(--vds-article-title-primary-font-size-xs)/1.6 var(--vds-article-title-primary-font-family);
  --vds-font-article-title-primary-bold-sm: 700 var(--vds-article-title-primary-font-size-sm)/1.6 var(--vds-article-title-primary-font-family);
  --vds-font-article-title-primary-bold-smd: 700 var(--vds-typography-font-size-700)/1.6 var(--vds-article-title-primary-font-family);
  --vds-font-article-title-primary-bold-md: 700 var(--vds-article-title-primary-font-size-md)/1.6 var(--vds-article-title-primary-font-family);
  --vds-font-article-title-primary-bold-mlg: 700 var(--vds-typography-font-size-1200)/1.6 var(--vds-article-title-primary-font-family);
  --vds-font-article-title-primary-bold-lg: 700 var(--vds-article-title-primary-font-size-lg)/1.6 var(--vds-article-title-primary-font-family);
  --vds-font-article-title-primary-bold-xl: 700 var(--vds-article-title-primary-font-size-xl)/1.6 var(--vds-article-title-primary-font-family);
  --vds-font-article-title-primary-black-xs: 900 var(--vds-article-title-primary-font-size-xs)/1.6 var(--vds-article-title-primary-font-family);

/* ---------- thời gian chờ, chi phí ---------- */
(function(){const hm=$('#weeksHome'),vn=$('#weeksVn');hm.innerHTML='<i></i>'.repeat(52);vn.innerHTML='<i></i>'.repeat(52);let tm=[];
  function play(){tm.forEach(clearTimeout);tm=[];$$('i',hm).concat($$('i',vn)).forEach(i=>i.classList.remove('f'));const d=RM?0:40;
    $$('i',vn).slice(0,2).forEach((x,k)=>tm.push(setTimeout(()=>x.classList.add('f'),k*280)));$$('i',hm).forEach((x,k)=>tm.push(setTimeout(()=>x.classList.add('f'),300+k*d)))}
  onView($('#waitBox'),play,.5);$('#waitReplay').addEventListener('click',play)})();
(function(){const r=$('#cost');const u=()=>{const v=+r.value;$('#cA').textContent=fmt(v)+' USD';$('#cV').textContent=fmt(v*.3)+'-'+fmt(v*.5)+' USD'};r.addEventListener('input',u);u()})();

/* ---------- 2.107 bệnh viện ---------- */
(function units(){
  const cv=$('#units'),ctx=cv.getContext('2d'),N=2107;let W,H,dpr,cols,cell,ox,oy,state=0,P={};
  const rnd=i=>{const x=Math.sin(i*78.233+1.7)*43758.5453;return x-Math.floor(x)};
  const pick=(n,seed)=>new Set([...Array(N).keys()].sort((p,q)=>rnd(p+seed)-rnd(q+seed)).slice(0,n));
  const S103=pick(103,11),S13=pick(13,37);
  const rgb=c=>{const x=document.createElement('canvas').getContext('2d');x.fillStyle=c;const v=x.fillStyle;if(v[0]==='#'){const n=parseInt(v.slice(1),16);return [n>>16,(n>>8)&255,n&255,1]}const m=v.match(/[\d.]+/g).map(Number);return [m[0],m[1],m[2],m[3]??1]};
  function pal(){P={g:[...rgb(tok('surface-300')),1],s:[...rgb(tok('border-support-regular')),1.15],o:[...rgb(tok('text-accent-strong')),1.9],d:[...rgb(tok('surface-200')),1]};P.d[3]=.9}
  const col=new Float32Array(N*4),scale=new Float32Array(N).fill(1);
  const tgt=i=>state===0?P.g:state===1?(S103.has(i)?P.s:P.d):(S13.has(i)?P.o:P.d);
  function size(){const b=cv.parentElement.getBoundingClientRect();dpr=Math.min(devicePixelRatio||1,2);W=b.width;H=b.height;cv.width=W*dpr;cv.height=H*dpr;
    let best=0;for(let c=20;c<=90;c++){const r=Math.ceil(N/c),sz=Math.min((W-12)/c,(H-12)/r);if(sz>best){best=sz;cols=c}}cell=best;ox=(W-cols*cell)/2;oy=(H-Math.ceil(N/cols)*cell)/2;draw()}
  function draw(){ctx.setTransform(dpr,0,0,dpr,0,0);ctx.clearRect(0,0,W,H);const r=cell*.36;
    for(const pass of [0,1])for(let i=0;i<N;i++){const big=scale[i]>1.05;if((pass===1)!==big)continue;const x=ox+(i%cols+.5)*cell,y=oy+(Math.floor(i/cols)+.5)*cell;
      ctx.fillStyle=`rgba(${col[i*4]|0},${col[i*4+1]|0},${col[i*4+2]|0},${col[i*4+3]})`;ctx.beginPath();ctx.arc(x,y,r*scale[i],0,6.283);ctx.fill()}}
  function go(s,instant){state=s;const tg=new Float32Array(N*4),ts=new Float32Array(N);for(let i=0;i<N;i++){const t=tgt(i);tg.set([t[0],t[1],t[2],t[3]],i*4);ts[i]=t[4]}
    const st=Float32Array.from(col),ss=Float32Array.from(scale),dl=new Float32Array(N);for(let i=0;i<N;i++)dl[i]=rnd(i+s*7)*.45;
    const apply=p=>{for(let i=0;i<N;i++){const q=instant?1:clamp((p-dl[i])/.55,0,1);for(let k=0;k<4;k++)col[i*4+k]=st[i*4+k]+(tg[i*4+k]-st[i*4+k])*q;scale[i]=ss[i]+(ts[i]-ss[i])*q}draw()};
    instant?apply(1):tween(1200,apply)}
  pal();for(let i=0;i<N;i++)col.set(P.g.slice(0,4),i*4);
  const big=$('#uBig'),sub=$('#uSub'),nums=[2107,103,13];let last=2107;
  size();
  scrolly($('#unitScrolly'),i=>{go(i);countTo(big,last,nums[i],800);last=nums[i];sub.innerHTML=T(`units.${i}`)});
  addEventListener('resize',size);
  new MutationObserver(()=>{pal();go(state,true)}).observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});
})();

/* ---------- bản đồ JCI ---------- */
(function jci(){
  const D=[{k:'hcm',ll:[106.66,10.78],a:'start'},{k:'ct',ll:[105.78,10.03],at:[106.0,8.75],a:'start'},{k:'hn',ll:[105.85,21.0],a:'start'},{k:'na',ll:[105.68,18.68],a:'start'},{k:'kh',ll:[109.19,12.24],a:'end'}];
  const box=$('#jciMap'),sel=$('#jciSel'),list=$('#jciList');let g='';
  D.slice().reverse().forEach(d=>{const J=C.jci[d.k],n=J.h.length,r=10+Math.sqrt(n)*5,at=d.at||d.ll;
    if(d.at){const [x1,y1]=rp(...d.ll),[x2,y2]=rp(...at);g+=`<line class="lead-l" x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}"/>`+mk(...d.ll,'<circle class="lead-dot" r="3"/>')}
    g+=`<g data-k="${d.k}" tabindex="0" role="button" aria-label="${esc(J.n)}: ${n} bệnh viện" style="cursor:pointer">`+mk(...at,`<circle class="bub" r="${r}"/><text class="bn">${n}</text><text class="bl" x="${d.a==='end'?-(r+6):r+6}" y="4.5" text-anchor="${d.a}">${esc(J.n)}</text>`)+`</g>`});
  box.innerHTML=`<svg class="mapsvg" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Bản đồ 13 bệnh viện đạt JCI tại Việt Nam">${baseMap(g)}</svg>`;
  const svg=$('svg',box);setVB(svg,bbox(101.6,7.6,115.6,23.6));
  function pick(k){chipSelect(sel,k);$$('.bub',svg).forEach(b=>b.classList.toggle('sel',b.closest('[data-k]').dataset.k===k));
    const J=C.jci[k];list.innerHTML=J.h.map((h,i)=>`<li><i>${String(i+1).padStart(2,'0')}</i><span>${T(`jci.${k}.h.${i}`)}${J.note[i]!=null?T(`jci.${k}.note.${i}`,'small'):''}</span></li>`).join('')}
  onChips(sel,dedupe(pick));
  svg.addEventListener('click',e=>{const t=e.target.closest('[data-k]');if(t)pick(t.dataset.k)});
  svg.addEventListener('keydown',e=>{const t=e.target.closest('[data-k]');if(t&&(e.key==='Enter'||e.key===' ')){e.preventDefault();pick(t.dataset.k)}});
  pick('hcm');
})();

/* ---------- so sánh khu vực ---------- */
(function cmp(){
  const M=[{type:'rank',d:{kr:5,my:6,vn:45},f:v=>v+'/50'},
    {d:{vn:300000,kr:2010000,my:1840000},f:v=>v>=1e6?fmt(v/1e6)+' triệu':fmt(v)},
    {d:{vn:21e6,kr:18e6,my:42e6},f:v=>fmt(v/1e6)+' triệu'},
    {d:{vn:300000/21e6*100,kr:2.01/18*100,my:1.84/42*100},f:v=>fmt(v)+'%'},
    {d:{vn:850.9e6,kr:2e9,my:822e6},f:v=>v>=1e9?fmt(v/1e9)+' tỷ USD':fmt(v/1e6)+' triệu USD'},
    {d:{vn:13,kr:6,th:68,my:17},f:v=>v+' cơ sở'}];
  const seg=$('#metrics'),rows=$('#cmpRows'),ins=$('#cmpIns'),src=$('#cmpSrc');let tokn=0;
  function show(i){i=+i;const m=M[i],my=++tokn,keys=Object.keys(m.d),max=Math.max(...Object.values(m.d));
    rows.innerHTML=keys.map(k=>`<div class="crow ${k}"><div class="c">${flag(k)}${T('names.'+k)}</div><div class="tr">${m.type==='rank'?'<span class="axis"></span><span class="rk" style="left:0"></span><span class="vl" style="left:0">':'<span class="fl" style="width:0"></span><span class="vl" style="left:8px">'}${m.f(m.d[k])}</span></div></div>`).join('');
    void rows.offsetWidth;(()=>{if(my!==tokn)return;keys.forEach((k,j)=>{const r=rows.children[j],v=m.d[k],vl=$('.vl',r);
      if(m.type==='rank'){const p=(v-1)/49;$('.rk',r).style.left=`calc(var(--vds-spacing-2xs) + ${p} * (100% - var(--vds-spacing-sm)))`;vl.style.left=p>.6?`calc(${p} * (100% - var(--vds-spacing-sm)) - 64px)`:`calc(${p} * (100% - var(--vds-spacing-sm)) + var(--vds-spacing-md))`}
      else{const p=v/max;$('.fl',r).style.width=(p*100)+'%';vl.classList.toggle('in',p>.62);vl.style.left=p>.62?'var(--vds-spacing-2xs)':`calc(${p*100}% + var(--vds-spacing-2xs))`}})})();
    ins.innerHTML=T(`cmp.${i}.ins`);src.innerHTML=T(`cmp.${i}.src`)}
  onChips(seg,dedupe(show));onView($('#cmp'),()=>show(0),.3);
})();

/* ---------- thị thực ---------- */
(function visa(){
  const tabs=$('#visaTabs'),gr=$('#vgrid'),V=C.visa;
  function show(k){let h=`<div class="vh">${flag(k)}${T('names.'+k)}</div><div class="vh b">${flag('vn')}${T('names.vn')}</div>`;
    V.rows.forEach((_,i)=>{h+=`<div class="rt">${T('visa.rows.'+i)}</div><div class="vc">${i===0?T(`visa.${k}.p`,'span','p'):''}${T(`visa.${k}.c.${i}`)}</div><div class="vc b">${i===0?T('visa.vn.p','span','p'):''}${T(`visa.vn.c.${i}`)}</div>`});gr.innerHTML=h}
  const keys=['kr','th','my'];
  tabs.addEventListener('vds:change',e=>show(keys[e.detail.index]??'kr'));
  tabs.addEventListener('click',e=>{const t=e.target.closest('[role=tab]');if(t)setTimeout(()=>show(keys[$$('[role=tab]',tabs).indexOf(t)]),0)});
  show('kr');
})();

/* ---------- hành trình ---------- */
(function journey(){
  const S=C.journey,st=$('#stations'),dots=$('#jdots'),cap=$('#jcap'),jn=$('#jn');
  st.innerHTML=S.map((s,i)=>`<div class="stn" data-i="${i}"><div class="no num">${String(i+1).padStart(2,'0')}</div><div>${T(`journey.${i}.0`,'h4')}<div class="side2"><div class="sd"><div class="who">${flag('my')}${T('names.my')}</div>${T(`journey.${i}.1`,'div')}</div>${s[2]?`<div class="sd vn"><div class="who">${flag('vn')}${T('names.vn')}</div>${T(`journey.${i}.2`,'div')}</div>`:`<div class="sd na">${T('journeyNA')}</div>`}</div></div></div>`).join('');
  dots.innerHTML=S.map((_,i)=>(i?'<u></u>':'')+'<i></i>').join('');
  const is=$$('i',dots),us=$$('u',dots),ss=$$('.stn',st);let t=false,cur=-1;
  function upd(){t=false;const line=innerHeight*.5;let k=0;ss.forEach((s,j)=>{if(s.getBoundingClientRect().top<line)k=j});if(k===cur)return;cur=k;
    ss.forEach((s,j)=>s.classList.toggle('on',j<=k));is.forEach((d,j)=>d.classList.toggle('on',j<=k));us.forEach((u,j)=>u.classList.toggle('on',j<k));cap.textContent=plain(`journey.${k}.0`);jn.textContent=(k+1)+'/9'}
  addEventListener('scroll',()=>{if(!t){t=true;requestAnimationFrame(upd)}},{passive:true});upd();
})();
})();

</script>
<script>/* Chế độ sửa: mở trang với ?edit (vd index.html?edit=1). Chữ có [data-e] (chữ tĩnh) và [data-c] (chữ của đồ họa,
   lưu trong khối JSON #copy) sửa được tại chỗ. Lưu: ghi đè index.html qua edit-server.py; mở bằng file:// thì dùng
   quyền ghi file của trình duyệt (Chrome, Edge); trình duyệt khác tải về bản index.html mới. */
(()=>{
'use strict';
const q=new URLSearchParams(location.search);
if(!q.has('edit')&&location.hash!=='#edit')return;
const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>[...r.querySelectorAll(s)];
const C=window.__COPY;if(!C)return;
const root=document.documentElement;root.classList.add('editing');
const bar=$('#edbar'),panel=$('#edpanel'),msg=$('#edmsg');
bar.hidden=false;panel.hidden=false;
const dirtyE=new Set();let dirtyC=false,handle=null,saving=false;

const getP=p=>p.split('.').reduce((o,k)=>o==null?o:o[k],C);
function setP(p,v){const ks=p.split('.');let o=C;for(let i=0;i<ks.length-1;i++)o=o[ks[i]];o[ks[ks.length-1]]=v}
function clean(el){const c=el.cloneNode(true);[c,...c.querySelectorAll('*')].forEach(n=>{n.removeAttribute('contenteditable');n.removeAttribute('spellcheck');n.removeAttribute('data-dirty')});
  return c.innerHTML.replace(/&nbsp;| /g,' ').replace(/(<br>\s*)+$/,'').trim()}
function count(){return dirtyE.size+(dirtyC?1:0)}
function status(t){msg.innerHTML=t??(count()?`<b>${count()}</b> chỗ đã sửa, chưa lưu`:'Bấm vào chữ để sửa · Ctrl/⌘ + S để lưu')}

function arm(el){if(el.isContentEditable||el.closest('#edbar,#edpanel'))return;el.contentEditable='true';el.spellcheck=false}
function armAll(r=document){$$('[data-e],[data-c]',r).forEach(arm)}
armAll();
new MutationObserver(ms=>ms.forEach(m=>m.addedNodes.forEach(n=>{if(n.nodeType!==1)return;if(n.matches('[data-e],[data-c]'))arm(n);armAll(n)}))).observe(document.body,{childList:true,subtree:true});

document.addEventListener('input',e=>{const el=e.target.closest('[data-e],[data-c]');if(!el)return;
  if(el.dataset.e){dirtyE.add(el.dataset.e);el.dataset.dirty='1'}
  else{const p=el.dataset.c,v=clean(el);setP(p,v);dirtyC=true;el.dataset.dirty='1';
    $$(`[data-c="${CSS.escape(p)}"]`).forEach(o=>{if(o!==el)o.innerHTML=v});const ta=panel.querySelector(`textarea[data-p="${CSS.escape(p)}"]`);if(ta)ta.value=v}
  status()},true);
document.addEventListener('keydown',e=>{
  if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='s'){e.preventDefault();save();return}
  const el=e.target.closest&&e.target.closest('[contenteditable=true]');
  if(el&&e.key==='Enter'){e.preventDefault();if(e.shiftKey)document.execCommand('insertLineBreak')}
  if(el&&e.key==='Escape')el.blur()},true);
document.addEventListener('paste',e=>{const el=e.target.closest&&e.target.closest('[contenteditable=true]');if(!el)return;e.preventDefault();document.execCommand('insertText',false,(e.clipboardData||window.clipboardData).getData('text/plain').replace(/\s*\n\s*/g,' '))},true);
// trong chế độ sửa, bấm vào link, nút trong vùng chữ không chuyển trang
document.addEventListener('click',e=>{if(e.target.closest('[contenteditable=true]')&&e.target.closest('a'))e.preventDefault()},true);
addEventListener('beforeunload',e=>{if(count()){e.preventDefault();e.returnValue=''}});

/* ---------- bảng chữ của đồ họa (gồm cả chữ trên bản đồ, canvas) ---------- */
const groups={names:'Tên quốc gia',hero:'Bản đồ thế giới',open:'Bản đồ mở đầu',plan:'Đề án 2030',waffle:'100 ô vuông',units:'2.107 bệnh viện',rank:'50 điểm đến',jci:'Bản đồ JCI',cmp:'So sánh khu vực',visa:'Thị thực',journey:'Hành trình bệnh nhân',journeyNA:'Hành trình bệnh nhân'};
function leaves(o,p,out){if(typeof o==='string'){out.push([p,o]);return out}if(o&&typeof o==='object')for(const k of Object.keys(o))leaves(o[k],p?p+'.'+k:k,out);return out}
function buildPanel(){const body=$('.body',panel);let h='',lastG='';
  leaves(C,'',[]).forEach(([p,v])=>{const g=p.split('.')[0];if(g==='_note'||/^rank\.list\.\d+\.1$/.test(p))return;
    if(g!==lastG){h+=`<div class="grp">${groups[g]||g}</div>`;lastG=g}
    h+=`<label><span>${p}</span><textarea data-p="${p}" rows="${Math.min(6,Math.ceil(v.length/48)||1)}"></textarea></label>`});
  body.innerHTML=h;$$('textarea',body).forEach(t=>t.value=getP(t.dataset.p))}
panel.addEventListener('input',e=>{const t=e.target.closest('textarea[data-p]');if(!t)return;setP(t.dataset.p,t.value);dirtyC=true;
  $$(`[data-c="${CSS.escape(t.dataset.p)}"]`).forEach(o=>o.innerHTML=t.value);status()});
$('#edPanelBtn').addEventListener('click',()=>{if(!panel.classList.contains('open'))buildPanel();panel.classList.toggle('open')});
$('#edPanelClose').addEventListener('click',()=>panel.classList.remove('open'));
$('#edExit').addEventListener('click',()=>{const u=new URL(location.href);u.searchParams.delete('edit');u.hash='';location.href=u.href});
$('#edSave').addEventListener('click',()=>save());

/* ---------- lưu ---------- */
function toast(kind,title,text){$$('#edtoast [data-kind]').forEach(t=>t.hidden=t.dataset.kind!==kind);const t=$(`#edtoast [data-kind="${kind}"]`);
  $('.vds-alert-toast__title',t).textContent=title;$('.vds-alert-toast__message',t).textContent=text;$('#edtoast').hidden=false;
  clearTimeout(toast.t);toast.t=setTimeout(()=>$('#edtoast').hidden=true,kind==='negative'?9000:4000)}
$('#edtoast').addEventListener('vds:dismiss',()=>$('#edtoast').hidden=true);
$('#edtoast').addEventListener('click',e=>{if(e.target.closest('.vds-alert-toast__dismiss'))$('#edtoast').hidden=true});

const isHttp=/^https?:$/.test(location.protocol);
async function viaServer(){if(!isHttp)return false;try{const r=await fetch('__ping',{cache:'no-store'});return r.ok&&(await r.text()).trim()==='vds-edit'}catch(e){return false}}
async function readSource(server){
  if(server){const r=await fetch(location.pathname,{cache:'no-store'});if(r.ok)return r.text();throw new Error('Không đọc được file từ máy chủ sửa bài.')}
  if(!handle){if(!window.showOpenFilePicker)return null;
    toast('info','Chọn file để lưu','Chọn chính file index.html của bài này. Trình duyệt sẽ xin quyền ghi file.');
    [handle]=await window.showOpenFilePicker({types:[{description:'Trang HTML',accept:{'text/html':['.html','.htm']}}]});
    if((await handle.requestPermission({mode:'readwrite'}))!=='granted'){handle=null;throw new Error('Chưa cấp quyền ghi file.')}}
  return (await handle.getFile()).text()}
function patch(src){const doc=new DOMParser().parseFromString(src,'text/html');let miss=0;
  dirtyE.forEach(id=>{const live=document.querySelector(`[data-e="${CSS.escape(id)}"]`),t=doc.querySelector(`[data-e="${CSS.escape(id)}"]`);if(live&&t)t.innerHTML=clean(live);else miss++});
  const cp=doc.getElementById('copy');if(cp)cp.textContent=JSON.stringify(C,null,1).replace(/</g,'\\u003c');
  doc.documentElement.removeAttribute('data-theme');doc.documentElement.classList.remove('editing');
  return {html:'<!doctype html>\n'+doc.documentElement.outerHTML+'\n',miss}}
async function save(){if(saving)return;if(!count()){toast('info','Chưa có thay đổi','Bấm vào một đoạn chữ để sửa.');return}
  saving=true;status('Đang lưu…');
  try{const server=await viaServer();const src=await readSource(server);
    if(src==null)throw new Error('Trình duyệt này không ghi được file. Mở bài bằng Sua-bai.command (hoặc chạy python3 edit-server.py) rồi sửa lại, hoặc dùng Chrome, Edge.');
    if(!/id="copy"/.test(src)||!/data-e="/.test(src))throw new Error('File đã chọn không phải bài này.');
    const {html,miss}=patch(src);
    if(server){const r=await fetch('__save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({html})});if(!r.ok)throw new Error(await r.text())}
    else{const w=await handle.createWritable();await w.write(html);await w.close()}
    done('Đã lưu vào index.html',miss?`${miss} đoạn không tìm thấy trong file, đã bỏ qua.`:`Lúc ${new Date().toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'})}. File sẵn sàng để xuất bản.`)}
  catch(e){saving=false;status();if(e&&e.name==='AbortError'){toast('info','Chưa lưu','Bạn đã đóng hộp chọn file.');return}toast('negative','Không lưu được',String(e&&e.message||e))}}
function done(title,text){dirtyE.clear();dirtyC=false;$$('[data-dirty]').forEach(el=>el.removeAttribute('data-dirty'));saving=false;status();toast('positive',title,text)}
status();
})();
</script>
</body>
</html>

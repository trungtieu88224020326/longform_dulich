(()=>{
'use strict';
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
const NS='http://www.w3.org/2000/svg';
const fmt=n=>new Intl.NumberFormat('vi-VN',{maximumFractionDigits:1}).format(n);
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const ease=t=>1-Math.pow(1-t,3);
const isDesk=()=>innerWidth>=1024;
const tok=n=>getComputedStyle(document.documentElement).getPropertyValue('--vds-'+n).trim();

/* ---------- chữ của đồ họa: khối JSON #copy, sửa được ở chế độ sửa ---------- */
const C=JSON.parse($('#copy').textContent);
window.__COPY=C;
const get=p=>p.split('.').reduce((o,k)=>o==null?o:o[k],C);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
// nội dung đã là HTML do người biên tập viết (có thể có <b>), chỉ chèn nguyên
const T=(p,tag='span',cls='')=>`<${tag} data-c="${p}"${cls?` class="${cls}"`:''}>${get(p)??''}</${tag}>`;
const plain=p=>{const d=document.createElement('div');d.innerHTML=get(p)??'';return d.textContent};
$$('[data-c]').forEach(el=>{el.innerHTML=get(el.dataset.c)??''});

const icons={};$$('[data-f]',$('#vdsIcons').content).forEach(s=>icons[s.dataset.f]=s.outerHTML);
const flag=k=>icons[k]||'';

function onView(el,cb,t=.25){if(!el)return;const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){cb(e);io.unobserve(e.target)}}),{threshold:t});io.observe(el)}
function tween(dur,fn,done){if(RM){fn(1);done&&done();return}const t0=performance.now();(function f(t){const p=clamp((t-t0)/dur,0,1);fn(ease(p));p<1?requestAnimationFrame(f):done&&done()})(t0)}
function countTo(el,from,to,dur=1100){tween(dur,p=>el.textContent=fmt(Math.round(from+(to-from)*p)))}
// nhóm chip VDS (role=radiogroup): phát sự kiện vds:change; hàm này đặt chọn bằng code
function chipSelect(group,value){$$('[role=radio]',group).forEach(c=>{const on=c.dataset.value===String(value);c.setAttribute('aria-checked',on);c.tabIndex=on?0:-1;c.classList.toggle('vds-selection-item-chip--selected',on)})}
function onChips(group,cb){group.addEventListener('vds:change',e=>cb(e.detail.value));group.addEventListener('click',e=>{const c=e.target.closest('[role=radio]');if(c)setTimeout(()=>cb(c.dataset.value),0)})}
function dedupe(cb){let last;return v=>{if(v===last)return;last=v;cb(v)}}

/* ---------- hiện dần ---------- */
const rio=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');rio.unobserve(e.target)}}),{threshold:.1,rootMargin:'0px 0px -5% 0px'});
$$('.rv').forEach(el=>rio.observe(el));

/* ---------- header: tiến độ đọc, tên chương, mục lục ---------- */
const prog=$('#prog'),chName=$('#chName'),chs=$$('[data-ch]');let tk=false;
function onScroll(){tk=false;const h=document.documentElement.scrollHeight-innerHeight;prog.style.transform=`scaleX(${clamp(scrollY/h,0,1)})`;
  let c=chs[0].dataset.ch;for(const s of chs){if(s.getBoundingClientRect().top<innerHeight*.5)c=s.dataset.ch;else break}if(chName.textContent!==c)chName.textContent=c}
addEventListener('scroll',()=>{if(!tk){tk=true;requestAnimationFrame(onScroll)}},{passive:true});onScroll();
const menu=$('#menu'),mb=$('#menuBtn');
function setMenu(o){menu.classList.toggle('open',o);menu.setAttribute('aria-hidden',!o);mb.setAttribute('aria-expanded',o);if(o)$('#menuClose').focus();else mb.focus()}
mb.addEventListener('click',()=>setMenu(true));$('#menuClose').addEventListener('click',()=>setMenu(false));
menu.addEventListener('click',e=>{if(e.target.classList.contains('scrim')||e.target.closest('a'))setMenu(false)});
addEventListener('keydown',e=>{if(e.key==='Escape'&&menu.classList.contains('open'))setMenu(false)});

/* ---------- cuộn kể chuyện: bước đổi khi thẻ chữ chạm vạch kích hoạt ---------- */
function scrolly(root,onStep){const steps=$$('.step',root),cards=steps.map(s=>$('.card',s));let cur=-1,t=false;
  const set=i=>{if(i===cur)return;cur=i;steps.forEach((s,j)=>s.classList.toggle('active',j===i));onStep(i)};
  function check(){t=false;const r=root.getBoundingClientRect();if(r.bottom<0||r.top>innerHeight)return;const line=innerHeight*(isDesk()?.55:.74);let k=0;cards.forEach((c,j)=>{if(c.getBoundingClientRect().top<line)k=j});set(k)}
  addEventListener('scroll',()=>{if(!t){t=true;requestAnimationFrame(check)}},{passive:true});
  set(0);check();return ()=>{const c=cur;cur=-1;set(c)}}

/* =====================================================
   Bản đồ thế giới (media nền tối)
===================================================== */
(function hero(){
  const cv=$('#heroCanvas'),ctx=cv.getContext('2d'),W0=GEO.world,raw=atob(W0.bits),dots=[];
  for(let j=0;j<W0.h;j++)for(let i=0;i<W0.w;i++){const k=j*W0.w+i;if(raw.charCodeAt(k>>3)&(128>>(k&7)))dots.push([W0.l0+(i+.5)*W0.step,W0.a1-(j+.5)*W0.step])}
  const HCM=[106.66,10.78];
  const src=[[104.92,11.56],[102.6,17.97],[126.98,37.57],[139.7,35.68],[151.2,-33.87],[2.35,48.85],[241.8,34.05],[236.9,49.28]];
  const hubs=[[1,28.98,41.0],[2,100.5,13.75],[3,77.2,28.6],[4,260.9,19.43],[5,126.98,37.57],[6,101.7,3.14],[8,103.82,1.35]];
  let W,H,s,cx,cy,dpr,base,col,t0=performance.now(),run=true,introDone=RM;
  const P=(lon,lat)=>[cx+(lon-106)*s,cy-(lat-14)*s];
  function colors(){col={dot:tok('text-on-color-subdued-lighter'),near:tok('text-on-color-subdued'),hub:tok('text-on-color-regular-lighter'),lab:tok('text-on-color-regular'),acc:tok('icon-fill-accent-regular'),accHi:tok('text-on-color-strong'),font:tok('microcopy-font-family')}}
  function size(){colors();dpr=Math.min(devicePixelRatio||1,2);W=cv.clientWidth;H=cv.clientHeight;cv.width=W*dpr;cv.height=H*dpr;
    s=Math.max(W/290,H/(W<700?140:120));cx=W*(W>900?.56:.55);cy=H*.46;
    base=document.createElement('canvas');base.width=cv.width;base.height=cv.height;drawDots(base.getContext('2d'),1e9)}
  function drawDots(c,t){c.setTransform(dpr,0,0,dpr,0,0);c.clearRect(0,0,W,H);const r=Math.max(.7,s*W0.step*.22);
    for(const [lon,lat] of dots){const [x,y]=P(lon,lat);if(x<-4||x>W+4||y<-4||y>H+4)continue;const d=Math.hypot(lon-106,lat-14);const a=clamp((t-d*8)/450,0,1);if(a<=0)continue;
      c.globalAlpha=a*(d<14?1:.75);c.fillStyle=d<14?col.near:col.dot;c.beginPath();c.arc(x,y,r,0,6.283);c.fill()}c.globalAlpha=1}
  const ctrl=(a,b)=>{const mx=(a[0]+b[0])/2,my=(a[1]+b[1])/2,dx=b[0]-a[0],L=Math.hypot(dx,b[1]-a[1]);return [mx-(b[1]-a[1])*.28*(dx>0?1:-1),my-Math.abs(dx)*.18-L*.12]};
  const qp=(a,c,b,u)=>{const v=1-u;return [v*v*a[0]+2*v*u*c[0]+u*u*b[0],v*v*a[1]+2*v*u*c[1]+u*u*b[1]]};
  function frame(now){if(!run)return;const t=now-t0;ctx.setTransform(1,0,0,1,0,0);ctx.clearRect(0,0,cv.width,cv.height);
    if(!introDone&&t<2400)drawDots(base.getContext('2d'),t);else if(!introDone){introDone=true;drawDots(base.getContext('2d'),1e9)}
    if(!base.width||!base.height){if(!RM)requestAnimationFrame(frame);return}
    ctx.drawImage(base,0,0);ctx.setTransform(dpr,0,0,dpr,0,0);
    const B=P(...HCM),fa=clamp((t-800)/800,0,1);
    src.forEach((sv,i)=>{const A=P(sv[0],sv[1]),Cc=ctrl(A,B);ctx.globalAlpha=.3*fa;ctx.strokeStyle=col.acc;ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(A[0],A[1]);ctx.quadraticCurveTo(Cc[0],Cc[1],B[0],B[1]);ctx.stroke();
      const sp=5600+i*500,u=((t+i*900)%sp)/sp;for(let k=0;k<12;k++){const uu=u-k*.012;if(uu<0)break;const p=qp(A,Cc,B,uu);ctx.globalAlpha=fa*(1-k/12);ctx.fillStyle=col.acc;ctx.beginPath();ctx.arc(p[0],p[1],k?1.4:2.2,0,6.283);ctx.fill()}});
    ctx.font=`700 11px ${col.font}`;ctx.textBaseline='middle';
    hubs.forEach((h,i)=>{const [x,y]=P(h[1],h[2]);if(x<0||x>W||y<0||y>H)return;const ha=clamp((t-1300-i*120)/500,0,1);
      ctx.globalAlpha=ha;ctx.strokeStyle=col.hub;ctx.lineWidth=1;ctx.beginPath();ctx.arc(x,y,5,0,6.283);ctx.stroke();ctx.fillStyle=col.hub;ctx.beginPath();ctx.arc(x,y,2,0,6.283);ctx.fill();
      const name=C.hero.hubs[i];const left=/Malaysia|Singapore|Thái Lan/.test(name)||x>W-110;ctx.textAlign=left?'right':'left';const oy=h[0]===8?9:h[0]===6?-4:h[0]===2?-6:0;
      if(W>520||h[0]===2||h[0]===5||h[0]>=6){ctx.fillStyle=col.lab;ctx.globalAlpha=ha*.85;ctx.fillText(`${h[0]} · ${name}`,x+(left?-9:9),y+oy)}});
    const va=clamp((t-500)/500,0,1),ph=((t/1000)%1.8)/1.8;
    ctx.globalAlpha=va*(1-ph)*.8;ctx.strokeStyle=col.acc;ctx.lineWidth=1.5;ctx.beginPath();ctx.arc(B[0],B[1],5+ph*22,0,6.283);ctx.stroke();
    ctx.globalAlpha=va;ctx.fillStyle=col.acc;ctx.beginPath();ctx.arc(B[0],B[1],4.5,0,6.283);ctx.fill();
    ctx.font=`700 12px ${col.font}`;ctx.textAlign='left';ctx.fillStyle=col.accHi;ctx.fillText(`45 · ${C.hero.vn}`,B[0]+10,B[1]+2);ctx.globalAlpha=1;
    if(!RM)requestAnimationFrame(frame)}
  size();addEventListener('resize',()=>{size();if(RM)frame(performance.now())});
  if(RM){t0=-1e5;frame(performance.now())}else requestAnimationFrame(frame);
  new IntersectionObserver(es=>{const v=es[0].isIntersecting;if(v&&!run&&!RM){run=true;requestAnimationFrame(frame)}else if(!v)run=false}).observe(cv);
  new MutationObserver(()=>{size();if(RM)frame(performance.now())}).observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});
})();

/* =====================================================
   Bản đồ khu vực (SVG)
===================================================== */
const R=GEO.region;
const rp=(lon,lat)=>[(lon-R.x0)*R.k,(R.y1-lat)*R.yk];
function mk(lon,lat,inner,cls=''){const [x,y]=rp(lon,lat);return `<g transform="translate(${x.toFixed(1)} ${y.toFixed(1)})"${cls?` class="${cls}"`:''}><g class="ns">${inner}</g></g>`}
function islands(){let s='';const rnd=i=>{const x=Math.sin(i*12.9898)*43758.5453;return x-Math.floor(x)};let n=0;
  [[111.2,16.0,112.9,17.1,16],[111.4,7.8,116.2,11.4,34]].forEach(([a,b,c,d,k])=>{for(let i=0;i<k;i++){n++;s+=mk(a+(c-a)*rnd(n),b+(d-b)*rnd(n+99),`<circle class="isl" r="${(0.8+rnd(n+7)).toFixed(1)}"/>`)}});
  return s+mk(112.1,17.55,'<text text-anchor="middle" class="isl-t">QĐ. Hoàng Sa</text>')+mk(113.8,11.9,'<text text-anchor="middle" class="isl-t">QĐ. Trường Sa</text>')}
function baseMap(extra=''){return ['in','bd','cn','tw','mm','th','my','id','ph','la','kh'].map(k=>`<path class="nb ${k}" d="${R[k]}"/>`).join('')+`<path class="vn" d="${R.vn}"/>${islands()}${extra}`}
function bbox(l0,a0,l1,a1){const [x0,y0]=rp(l0,a1),[x1,y1]=rp(l1,a0);return [x0,y0,x1-x0,y1-y0]}
function setVB(svg,b){svg.setAttribute('viewBox',b.map(v=>v.toFixed(1)).join(' '));svg._vb=b;const w=svg.clientWidth,h=svg.clientHeight;if(w&&h)svg.style.setProperty('--k',Math.max(b[2]/w,b[3]/h).toFixed(4))}
addEventListener('resize',()=>$$('svg.mapsvg').forEach(s=>s._vb&&setVB(s,s._vb)));
function tweenVB(svg,to,dur=1000){const from=svg.getAttribute('viewBox').split(' ').map(Number);tween(dur,p=>setVB(svg,from.map((f,i)=>f+(to[i]-f)*p)))}

(function opening(){
  const box=$('#openMap'),O=C.open,PP=rp(104.92,11.56),HC=rp(106.66,10.78),VT=rp(102.6,17.97),HN=rp(105.85,21.03),DN=rp(108.2,16.05);
  const route=`M${PP} Q${(PP[0]+HC[0])/2+6},${(PP[1]+HC[1])/2-34} ${HC}`;
  const E=(lon,lat)=>rp(lon,lat).map(v=>v.toFixed(1)).join(','),LX=isDesk()?122.6:117.6;
  const flows=[[`M${E(125,26)} Q${E(113,22.5)} ${HN}`,0,[LX,23.4]],[`M${E(125,15.5)} Q${E(114,14)} ${HC}`,1,[LX,16.2]],[`M${E(124,1.5)} Q${E(113,6.5)} ${HC}`,2,[LX,6.6]],[`M${VT} Q${E(105,17.6)} ${DN}`,-1],[route,-1]];
  const city=(lon,lat,t,cls,anc='start',dx=9,r=4)=>mk(lon,lat,`<circle class="city ${cls}" r="${r}"/><text x="${dx}" y="4" class="lb" text-anchor="${anc}">${esc(t)}</text>`);
  const cty=(lon,lat,t)=>mk(lon,lat,`<text class="cty" text-anchor="middle">${esc(t)}</text>`);
  box.innerHTML=`<svg class="mapsvg" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Bản đồ: hành trình của bệnh nhân Campuchia tới TP HCM">${baseMap()}
    ${cty(104.3,13.1,O.countries.kh)}${cty(103.6,19.6,O.countries.la)}${cty(101,15.6,O.countries.th)}${cty(107.7,14.2,O.countries.vn)}${cty(97,20.5,O.countries.mm)}${cty(108,23.8,O.countries.cn)}${cty(101.8,4.5,O.countries.my)}
    <g class="fade" id="gFlows">${flows.map((f,i)=>`<path id="fl${i}" class="flow" d="${f[0]}"/>${f[1]>=0?mk(f[2][0],f[2][1],`<text text-anchor="end" class="fl-t">${esc(O.flows[f[1]])}</text>`):''}`).join('')}<g id="parts"></g></g>
    <path class="route" id="route" d="${route}"/>
    ${city(104.92,11.56,O.cities.pp,'','end',-9)}${city(106.66,10.78,O.cities.hcm,'hcm','start',11,6)}${city(105.85,21.03,O.cities.hn,'','start',8,3.5)}${city(108.2,16.05,O.cities.dn,'','start',8,3)}
    <g class="fade" id="y23">${mk(106.66,10.78,`<text class="yr" x="11" y="26">${esc(O.y23)}</text>`)}</g>
    <g class="fade" id="y26">${mk(106.66,10.78,`<text class="yr b" x="11" y="46">${esc(O.y26)}</text>`)}</g></svg>`;
  const svg=$('svg',box),rt=$('#route',svg),L=rt.getTotalLength();rt.style.strokeDasharray=L;rt.style.strokeDashoffset=L;
  const close=()=>bbox(101.8,8.6,109.6,14.6),wide=()=>isDesk()?bbox(98.5,5.5,124.8,24.5):bbox(101.2,7,118.2,23.6);
  setVB(svg,close());
  const pill=$('#openPill'),cnt=$('#openCount'),paths=flows.map((f,i)=>$('#fl'+i,svg)),lens=paths.map(p=>p.getTotalLength()),partsG=$('#parts',svg);let counted=false,raf=0;
  function startParts(){if(RM||raf)return;partsG.innerHTML='';const k=parseFloat(svg.style.getPropertyValue('--k'))||1,parts=[];
    for(let i=0;i<30;i++){const c=document.createElementNS(NS,'circle');c.setAttribute('r',(2.4*k).toFixed(2));c.setAttribute('class','part');partsG.appendChild(c);parts.push({c,p:i%paths.length,o:Math.random(),sp:.0001+Math.random()*.00008})}
    const t0=performance.now();(function f(t){parts.forEach(q=>{const u=(q.o+(t-t0)*q.sp)%1,pt=paths[q.p].getPointAtLength(u*lens[q.p]);q.c.setAttribute('cx',pt.x);q.c.setAttribute('cy',pt.y);q.c.setAttribute('opacity',Math.sin(u*Math.PI).toFixed(2))});raf=requestAnimationFrame(f)})(t0)}
  const stopParts=()=>{cancelAnimationFrame(raf);raf=0};
  scrolly($('#openScrolly'),i=>{
    $$('.kh',svg).forEach(k=>k.classList.toggle('hl',i<3));
    if(i===2&&!RM){rt.style.transition='none';rt.style.strokeDashoffset=L;void rt.getBoundingClientRect()}
    rt.style.transition=RM?'none':'stroke-dashoffset 1.5s ease';rt.style.strokeDashoffset=i>=1?0:L;rt.style.opacity=i===3?0:1;
    $('#y23',svg).classList.toggle('on',i===1||i===2);$('#y26',svg).classList.toggle('on',i===2);$('#gFlows',svg).classList.toggle('on',i===3);
    tweenVB(svg,i===3?wide():close());pill.classList.toggle('on',i===3);
    if(i===3){startParts();if(!counted){counted=true;countTo(cnt,0,300000,1600)}}else stopParts()});
})();

/* ---------- đề án 2030 ---------- */
(function plan(){
  const A=$('#pmA'),B=$('#pmB'),seg=$('#planSeg');let y='25',auto=true;
  function set(v){if(v===y)return;y=v;chipSelect(seg,v);[A,B].forEach(e=>e.classList.toggle('y30',v==='30'));
    const a=$('.num',A),b=$('.num',B);
    if(v==='30'){countTo(a,300000,750000);$('.fill',A).style.width='100%';b.textContent='2,5';$('.fill',B).style.width='100%';$('.x',A).innerHTML=T('plan.x30a');$('.x',B).innerHTML=T('plan.x30b')}
    else{countTo(a,750000,300000,700);$('.fill',A).style.width='40%';b.textContent='1-2';$('.fill',B).style.width='60%';$('.x',A).textContent='';$('.x',B).textContent=''}}
  onChips(seg,v=>{auto=false;set(v)});
  onView($('#plan'),()=>setTimeout(()=>{if(auto)set('30')},900),.5);
})();

/* ---------- 100 ô ---------- */
(function waffle(){
  const svg=$('#waffle');let h='';
  for(let i=0;i<100;i++){const x=(i%10)*12,y=Math.floor(i/10)*12;h+=`<rect class="b" x="${x}" y="${y}" width="10" height="10"/><rect class="o" x="${x}" y="${y}" width="10" height="10" style="transition-delay:${i*8}ms"/>`}
  svg.innerHTML=h;const os=$$('.o',svg),big=$('#wBig'),sub=$('#wSub'),key=$('#wKey');
  const fills=[0,9,25.5,3.55,.49];
  const sw=['var(--c-track)','var(--c-other)'];
  const render=scrolly($('#waffleScrolly'),i=>{svg.classList.toggle('vn',i===4);
    os.forEach((o,k)=>o.style.transform=`scaleX(${clamp(fills[i]-k,0,1)})`);
    big.innerHTML=T(`waffle.${i}.big`);sub.innerHTML=T(`waffle.${i}.sub`);
    key.innerHTML=C.waffle[i].keys.map((_,j)=>`<span><i style="background:${j?(i===4?'var(--c-vn)':sw[1]):sw[0]}"></i>${T(`waffle.${i}.keys.${j}`)}</span>`).join('');
    svg.setAttribute('aria-label',plain(`waffle.${i}.big`)+'. '+plain(`waffle.${i}.sub`))});
})();

onView($('#growth'),()=>{$$('#growth .gbars').forEach(g=>g.classList.add('in'));$$('#growth .col').forEach(c=>c.style.height=c.dataset.h+'%')},.35);

/* ---------- 50 điểm đến ---------- */
(function rank(){
  const g=$('#grid50'),info=$('#rankInfo'),seg=$('#rankSeg'),L=C.rank.list;let f='asia',sel=45;
  const groups={asia:['asia'],europe:['europe','eurasia'],america:['na','ca','sa','carib'],mea:['me','africa'],oceania:['oceania'],all:null};
  g.innerHTML=L.map((c,i)=>`<button class="cell${i===44?' vn':''}" data-r="${i+1}" aria-label="Hạng ${i+1}: ${esc(c[0])}"><span class="r num">${i+1}</span><span class="nm" data-c="rank.list.${i}.0">${c[0]}</span></button>`).join('');
  const inG=(i)=>!groups[f]||groups[f].includes(L[i][1]);
  function paint(){$$('.cell',g).forEach((c,i)=>{const m=inG(i);c.classList.toggle('on',f!=='all'&&m&&i!==44);c.classList.toggle('dim',!m&&i!==44)})}
  function show(r){sel=r;const i=r-1;$$('.cell',g).forEach(c=>c.classList.toggle('sel',+c.dataset.r===r));
    const reg=C.rank.regions[L[i][1]];
    const note=r===45?T('rank.vnNote'):r===1?T('rank.firstNote'):'';
    info.innerHTML=`<b>${r} · ${esc(plain(`rank.list.${i}.0`))}</b> <span class="meta">${esc(reg)}</span>${note?'<br>'+note:''}`}
  g.addEventListener('click',e=>{const c=e.target.closest('.cell');if(c&&!document.documentElement.classList.contains('editing'))show(+c.dataset.r)});
  onChips(seg,dedupe(v=>{f=v;paint();const n=groups[v]?L.filter((_,i)=>inG(i)).length:50;if(sel!==45&&!inG(sel-1))show(45)}));
  paint();show(45);
})();

/* ---------- ông Akira ---------- */
(function(){const r=$('#akira');let h='';for(let i=0;i<11;i++)h+=`<i style="transition-delay:${i*60}ms" title="Bệnh viện tại Nhật"></i>`;
  r.innerHTML=h+`<em>+ nước ngoài</em><i class="vn" style="transition-delay:${11*60+150}ms">An Sinh · 2014</i>`;onView(r,()=>r.classList.add('in'),.6)})();

